# Canonical repository-local development artifacts
/.artifacts/
/docs/help/assets/icon-contact-sheets/
# Generated semantic-test catalog output belongs in the published site artifact, never source docs.
/docs/engineering/semantic-test-catalog.html
/docs/engineering/semantic-test-catalog.v1.json
/.next/*
# Rust
/target/

# Node and frontend build output
**/node_modules/
**/dist/
**/*.tsbuildinfo
**/test-results/
**/playwright-report/
**/coverage/
**/storybook-static/
/.pnpm-store/

# Runtime desk/show data
/light-data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.show
*.show-shm
*.show-wal
!/assets/demo.show
*.log
*.pid
*.pyc

__pycache__
# Legacy generated output locations (kept visible so regressions are not hidden)
/output/
/tmp/

# Local tooling and operating-system files
/.claude/
.DS_Store
.env
.env.*
!.env.example
*.profraw
*.profdata

# Existing Help PNGs remain for compatibility. Refreshed Help/marketing captures are generated,
# reviewed and uploaded by the documentation workflow rather than committed.
/docs/marketing/assets/screenshots/

# Authored diagram SVGs are source; manual-build raster copies are generated.
/docs/help/assets/diagrams/*.png
