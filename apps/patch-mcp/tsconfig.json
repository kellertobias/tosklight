{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"skipLibCheck": true,
		"esModuleInterop": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"isolatedModules": true,
		"noEmit": true,
		"types": ["vitest/globals"]
	},
	"include": ["src", "vitest.config.ts"]
}
