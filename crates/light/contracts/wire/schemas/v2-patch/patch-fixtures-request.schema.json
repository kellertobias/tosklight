{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PatchFixturesRequest",
  "description": "Body of the atomic, idempotent `PatchFixtures` POST operation.",
  "type": "object",
  "properties": {
    "fixtures": {
      "description": "Fixture upserts. The application service requires at least one upsert or removal.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PatchFixtureInput"
      }
    },
    "placements": {
      "description": "Server-resolved placement intents. Empty retains the generic desired-state Patch behavior\nwhere fixture split assignments are already explicit.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PatchPlacementIntent"
      }
    },
    "remove_fixture_ids": {
      "description": "Stable fixture identities removed by the same atomic operation. Already-absent identities\nare accepted as the requested desired state.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "request_id": {
      "description": "Client-generated idempotency identity, scoped to the authenticated desk session.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "vector_spreads": {
      "description": "Server-resolved coordinate spreads over an explicitly ordered fixture selection.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PatchVectorSpreadIntent"
      }
    }
  },
  "required": [
    "request_id"
  ],
  "$defs": {
    "PatchDirectControlEndpoint": {
      "type": "object",
      "properties": {
        "ip_address": {
          "description": "Transport adapters validate this as an IP address before invoking the application service.",
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "protocol": {
          "$ref": "#/$defs/PatchDirectControlProtocol"
        }
      },
      "required": [
        "protocol",
        "ip_address",
        "port"
      ]
    },
    "PatchDirectControlProtocol": {
      "type": "string",
      "enum": [
        "citp"
      ]
    },
    "PatchFixtureInput": {
      "description": "One fixture candidate containing only identities and state owned by the portable patch.",
      "type": "object",
      "properties": {
        "bracket_angle": {
          "description": "Degrees the mounting bracket is set to, positive nose-down. A mechanical setting the desk\ncannot drive, recorded so the visualizer draws the rig as it actually hangs.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "direct_control": {
          "anyOf": [
            {
              "$ref": "#/$defs/PatchDirectControlEndpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixture_id": {
          "description": "Stable identity generated once by the caller and retained across an idempotent retry.",
          "type": "string",
          "format": "uuid"
        },
        "fixture_number": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "grand_master_enabled": {
          "type": "boolean",
          "default": true
        },
        "group_masters_enabled": {
          "type": "boolean",
          "default": true
        },
        "highlight_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PatchHighlightOverrideInput"
          }
        },
        "installed_appearance": {
          "$ref": "#/$defs/PatchInstalledFixtureAppearance",
          "default": {
            "color_temperature_kelvin": null,
            "gel": {
              "type": "open_white"
            },
            "light_source": {
              "type": "profile_default"
            },
            "luminous_output_lumens": null,
            "shaper_angles_degrees": [
              0.0,
              0.0,
              0.0,
              0.0
            ]
          }
        },
        "internal_bindings": {
          "$ref": "#/$defs/PatchInternalFixtureBindings",
          "default": {
            "library": null,
            "output": null
          }
        },
        "invert_pan": {
          "type": "boolean",
          "default": false
        },
        "invert_tilt": {
          "type": "boolean",
          "default": false
        },
        "layer_id": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/PatchFixtureLocation"
        },
        "mode_id": {
          "type": "string",
          "format": "uuid"
        },
        "move_in_black_delay_millis": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "move_in_black_enabled": {
          "type": "boolean"
        },
        "multipatch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PatchMultiPatchInput"
          }
        },
        "name": {
          "type": "string"
        },
        "profile_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rotation": {
          "$ref": "#/$defs/PatchFixtureRotation"
        },
        "shaper_angle": {
          "description": "Degrees a fitted shaper or barn-door module is turned to, or absent when none is fitted.",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "split_patches": {
          "description": "Canonical split assignments. An unpatched split has two `null` address fields.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PatchSplitAssignment"
          },
          "minItems": 1
        },
        "virtual_fixture_number": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "fixture_id",
        "name",
        "profile_id",
        "profile_revision",
        "mode_id",
        "split_patches",
        "layer_id",
        "location",
        "rotation",
        "multipatch",
        "move_in_black_enabled",
        "move_in_black_delay_millis",
        "highlight_overrides"
      ]
    },
    "PatchFixtureLocation": {
      "description": "Stage position in integer millimetres.",
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        },
        "z": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "PatchFixtureRotation": {
      "description": "Stage rotation in degrees.",
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "z": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "PatchGelAssignment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "open_white"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "catalog_id": {
              "type": "string"
            },
            "embedded_fallback": {
              "$ref": "#/$defs/PatchGelDefinitionSnapshot"
            },
            "entry_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "built_in"
            }
          },
          "required": [
            "type",
            "catalog_id",
            "entry_id",
            "embedded_fallback"
          ]
        },
        {
          "type": "object",
          "properties": {
            "color_srgb": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "custom"
            }
          },
          "required": [
            "type",
            "name",
            "color_srgb"
          ]
        }
      ]
    },
    "PatchGelDefinitionSnapshot": {
      "type": "object",
      "properties": {
        "display_srgb": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "visualizer_srgb": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "name",
        "display_srgb",
        "visualizer_srgb"
      ]
    },
    "PatchHighlightOverrideInput": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "format": "uuid"
        },
        "raw_value": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "channel_id",
        "raw_value"
      ]
    },
    "PatchInstalledFixtureAppearance": {
      "description": "Portable installed lamp/filter/static-shaper appearance for one physical fixture instance.",
      "type": "object",
      "properties": {
        "color_temperature_kelvin": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "gel": {
          "$ref": "#/$defs/PatchGelAssignment",
          "default": {
            "type": "open_white"
          }
        },
        "light_source": {
          "$ref": "#/$defs/PatchInstalledLightSource",
          "default": {
            "type": "profile_default"
          }
        },
        "luminous_output_lumens": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "shaper_angles_degrees": {
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        }
      }
    },
    "PatchInstalledLightSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "profile_default"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tungsten"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "halogen"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "discharge"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "led"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "fluorescent"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "arc"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "other"
            }
          },
          "required": [
            "type",
            "label"
          ]
        }
      ]
    },
    "PatchInternalFixtureBindings": {
      "description": "Portable names resolved to machine-local audio resources by each desk.",
      "type": "object",
      "properties": {
        "library": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PatchMultiPatchInput": {
      "type": "object",
      "properties": {
        "bracket_angle": {
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "installed_appearance": {
          "$ref": "#/$defs/PatchInstalledFixtureAppearance",
          "default": {
            "color_temperature_kelvin": null,
            "gel": {
              "type": "open_white"
            },
            "light_source": {
              "type": "profile_default"
            },
            "luminous_output_lumens": null,
            "shaper_angles_degrees": [
              0.0,
              0.0,
              0.0,
              0.0
            ]
          }
        },
        "invert_pan": {
          "type": "boolean",
          "default": false
        },
        "invert_tilt": {
          "type": "boolean",
          "default": false
        },
        "location": {
          "$ref": "#/$defs/PatchFixtureLocation"
        },
        "name": {
          "type": "string"
        },
        "rotation": {
          "$ref": "#/$defs/PatchFixtureRotation"
        },
        "shaper_angle": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "split_patches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PatchSplitAssignment"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "split_patches",
        "location",
        "rotation"
      ]
    },
    "PatchOperatorAddressOverride": {
      "description": "Sparse operator-selected address replacing the deterministic proposal for one fixture.",
      "type": "object",
      "properties": {
        "address": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "fixture_id": {
          "type": "string",
          "format": "uuid"
        },
        "universe": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "fixture_id",
        "universe",
        "address"
      ]
    },
    "PatchPlacementIntent": {
      "description": "One ordered fixture batch whose per-split addresses are resolved by the server.",
      "type": "object",
      "properties": {
        "fixture_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1
        },
        "splits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PatchSplitPlacementIntent"
          },
          "minItems": 1
        }
      },
      "required": [
        "fixture_ids",
        "splits"
      ]
    },
    "PatchSplitAssignment": {
      "type": "object",
      "properties": {
        "address": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "split": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "universe": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "split"
      ]
    },
    "PatchSplitPlacementIntent": {
      "description": "Base address and deterministic assignment mode for one selected-mode split.",
      "type": "object",
      "properties": {
        "address": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/PatchSplitPlacementMode"
        },
        "split": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "universe": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "split",
        "mode"
      ]
    },
    "PatchSplitPlacementMode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "consecutive"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "overrides": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/PatchOperatorAddressOverride"
              }
            },
            "type": {
              "type": "string",
              "const": "operator_overrides"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "PatchVectorAxis": {
      "type": "string",
      "enum": [
        "x",
        "y",
        "z"
      ]
    },
    "PatchVectorKind": {
      "type": "string",
      "enum": [
        "location",
        "rotation"
      ]
    },
    "PatchVectorSpreadIntent": {
      "description": "One ordered, server-resolved spread for a patch-owned location or rotation axis.",
      "type": "object",
      "properties": {
        "axis": {
          "$ref": "#/$defs/PatchVectorAxis"
        },
        "fixture_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1
        },
        "kind": {
          "$ref": "#/$defs/PatchVectorKind"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2
        }
      },
      "required": [
        "fixture_ids",
        "kind",
        "axis",
        "points"
      ]
    }
  }
}
