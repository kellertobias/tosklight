{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PatchFixtureProjection",
  "description": "Portable, authoritative Patch representation of one fixture without an inline definition.",
  "type": "object",
  "properties": {
    "bracket_angle": {
      "type": "number",
      "format": "float"
    },
    "direct_control": {
      "anyOf": [
        {
          "$ref": "#/$defs/PatchDirectControlEndpoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "fixture_id": {
      "type": "string",
      "format": "uuid"
    },
    "fixture_number": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "fixture_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "freeze_targets": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PatchFixtureFreezeTargetProjection"
      }
    },
    "grand_master_enabled": {
      "type": "boolean"
    },
    "group_masters_enabled": {
      "type": "boolean"
    },
    "highlight_overrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PatchHighlightOverrideProjection"
      }
    },
    "installed_appearance": {
      "$ref": "#/$defs/PatchInstalledFixtureAppearance"
    },
    "internal_bindings": {
      "$ref": "#/$defs/PatchInternalFixtureBindings",
      "default": {
        "library": null,
        "output": null
      }
    },
    "invert_pan": {
      "type": "boolean"
    },
    "invert_tilt": {
      "type": "boolean"
    },
    "layer_id": {
      "type": "string"
    },
    "location": {
      "$ref": "#/$defs/PatchFixtureLocation"
    },
    "logical_heads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PatchLogicalHeadProjection"
      }
    },
    "mode_id": {
      "type": "string",
      "format": "uuid"
    },
    "move_in_black_delay_millis": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "move_in_black_enabled": {
      "type": "boolean"
    },
    "multipatch": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PatchMultiPatchProjection"
      }
    },
    "name": {
      "type": "string"
    },
    "note": {
      "description": "An operator's own note against this fixture.",
      "type": [
        "string",
        "null"
      ]
    },
    "position_master": {
      "description": "The 3D Point this fixture is slaved to. A client that cannot read this back could not tell\na slaved fixture from a loose one.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "profile_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "rotation": {
      "$ref": "#/$defs/PatchFixtureRotation"
    },
    "shaper_angle": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "split_patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PatchSplitAssignment"
      }
    },
    "virtual_fixture_number": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "fixture_id",
    "fixture_revision",
    "fixture_number",
    "virtual_fixture_number",
    "name",
    "profile_id",
    "profile_revision",
    "mode_id",
    "split_patches",
    "layer_id",
    "direct_control",
    "internal_bindings",
    "location",
    "rotation",
    "logical_heads",
    "multipatch",
    "group_masters_enabled",
    "grand_master_enabled",
    "invert_pan",
    "invert_tilt",
    "bracket_angle",
    "shaper_angle",
    "installed_appearance",
    "move_in_black_enabled",
    "move_in_black_delay_millis",
    "highlight_overrides",
    "freeze_targets"
  ],
  "$defs": {
    "PatchDirectControlEndpoint": {
      "type": "object",
      "properties": {
        "ip_address": {
          "description": "Transport adapters validate this as an IP address before invoking the application service.",
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "protocol": {
          "$ref": "#/$defs/PatchDirectControlProtocol"
        }
      },
      "required": [
        "protocol",
        "ip_address",
        "port"
      ]
    },
    "PatchDirectControlProtocol": {
      "type": "string",
      "enum": [
        "citp"
      ]
    },
    "PatchFixtureFreezeFamily": {
      "type": "string",
      "enum": [
        "intensity",
        "color",
        "position",
        "beam"
      ]
    },
    "PatchFixtureFreezeTargetProjection": {
      "type": "object",
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PatchFixtureFreezeFamily"
          }
        },
        "fixture_id": {
          "type": "string",
          "format": "uuid"
        },
        "full": {
          "type": "boolean"
        }
      },
      "required": [
        "fixture_id",
        "full",
        "families"
      ]
    },
    "PatchFixtureLocation": {
      "description": "Stage position in integer millimetres.",
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        },
        "z": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "PatchFixtureRotation": {
      "description": "Stage rotation in degrees.",
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "z": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "PatchGelAssignment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "open_white"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "catalog_id": {
              "type": "string"
            },
            "embedded_fallback": {
              "$ref": "#/$defs/PatchGelDefinitionSnapshot"
            },
            "entry_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "built_in"
            }
          },
          "required": [
            "type",
            "catalog_id",
            "entry_id",
            "embedded_fallback"
          ]
        },
        {
          "type": "object",
          "properties": {
            "color_srgb": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "custom"
            }
          },
          "required": [
            "type",
            "name",
            "color_srgb",
            "note"
          ]
        }
      ]
    },
    "PatchGelDefinitionSnapshot": {
      "type": "object",
      "properties": {
        "display_srgb": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "visualizer_srgb": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "name",
        "display_srgb",
        "visualizer_srgb"
      ]
    },
    "PatchHighlightOverrideProjection": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "format": "uuid"
        },
        "raw_value": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "channel_id",
        "raw_value"
      ]
    },
    "PatchInstalledFixtureAppearance": {
      "description": "Portable installed lamp/filter/static-shaper appearance for one physical fixture instance.",
      "type": "object",
      "properties": {
        "color_temperature_kelvin": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "gel": {
          "$ref": "#/$defs/PatchGelAssignment",
          "default": {
            "type": "open_white"
          }
        },
        "light_source": {
          "$ref": "#/$defs/PatchInstalledLightSource",
          "default": {
            "type": "profile_default"
          }
        },
        "luminous_output_lumens": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "shaper_angles_degrees": {
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        }
      },
      "required": [
        "light_source",
        "color_temperature_kelvin",
        "luminous_output_lumens",
        "gel",
        "shaper_angles_degrees"
      ]
    },
    "PatchInstalledLightSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "profile_default"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tungsten"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "halogen"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "discharge"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "led"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "fluorescent"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "arc"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "other"
            }
          },
          "required": [
            "type",
            "label"
          ]
        }
      ]
    },
    "PatchInternalFixtureBindings": {
      "description": "Portable names resolved to machine-local audio resources by each desk.",
      "type": "object",
      "properties": {
        "library": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "library",
        "output"
      ]
    },
    "PatchLogicalHeadProjection": {
      "type": "object",
      "properties": {
        "fixture_id": {
          "type": "string",
          "format": "uuid"
        },
        "head_index": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "profile_head_id": {
          "description": "Stable semantic head identity from the selected immutable profile revision.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "profile_head_id",
        "head_index",
        "fixture_id"
      ]
    },
    "PatchMultiPatchProjection": {
      "type": "object",
      "properties": {
        "bracket_angle": {
          "type": "number",
          "format": "float"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "installed_appearance": {
          "$ref": "#/$defs/PatchInstalledFixtureAppearance"
        },
        "invert_pan": {
          "type": "boolean"
        },
        "invert_tilt": {
          "type": "boolean"
        },
        "location": {
          "$ref": "#/$defs/PatchFixtureLocation"
        },
        "name": {
          "type": "string"
        },
        "rotation": {
          "$ref": "#/$defs/PatchFixtureRotation"
        },
        "shaper_angle": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "split_patches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PatchSplitAssignment"
          }
        }
      },
      "required": [
        "id",
        "name",
        "split_patches",
        "location",
        "rotation",
        "invert_pan",
        "invert_tilt",
        "bracket_angle",
        "shaper_angle",
        "installed_appearance"
      ]
    },
    "PatchSplitAssignment": {
      "type": "object",
      "properties": {
        "address": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "split": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "universe": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "split",
        "universe",
        "address"
      ]
    }
  }
}
