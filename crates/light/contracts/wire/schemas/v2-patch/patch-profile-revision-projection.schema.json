{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PatchProfileRevisionProjection",
  "description": "Deduplicated, Patch-only metadata for one immutable profile revision.",
  "type": "object",
  "properties": {
    "content_digest": {
      "type": "string"
    },
    "fixture_type": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "patch_policy": {
      "$ref": "#/$defs/PatchProfilePolicy"
    },
    "profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "profile_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "profile_snapshot": {
      "description": "Server-resolved parameterized profile snapshot for this revision. Patch programmer-surface\nconsumers build head parameters, channels, and control actions from it client-side without\nthe fixture catalog. Carried server->client only; the patch *request* boundary still\nexcludes fixture definitions. Absent (null) on older payloads, so clients must tolerate it."
    },
    "referenced_modes": {
      "description": "Only modes referenced by fixtures in the containing snapshot or delta, never the catalog.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PatchModeProjection"
      },
      "minItems": 1
    }
  },
  "required": [
    "profile_id",
    "profile_revision",
    "content_digest",
    "manufacturer",
    "name",
    "fixture_type",
    "patch_policy",
    "referenced_modes"
  ],
  "$defs": {
    "PatchModeProjection": {
      "type": "object",
      "properties": {
        "mode_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "native_color_identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PatchNativeColorIdentity"
          }
        },
        "position_calibration_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/PatchPositionCalibrationIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "splits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PatchModeSplitProjection"
          }
        }
      },
      "required": [
        "mode_id",
        "name",
        "splits"
      ]
    },
    "PatchModeSplitProjection": {
      "type": "object",
      "properties": {
        "footprint": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "split": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "split",
        "footprint"
      ]
    },
    "PatchNativeColorIdentity": {
      "type": "object",
      "properties": {
        "head_id": {
          "type": "string",
          "format": "uuid"
        },
        "mode_id": {
          "type": "string",
          "format": "uuid"
        },
        "model_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "native_layout_signature": {
          "type": "string"
        },
        "path_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_digest": {
          "type": "string"
        },
        "profile_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "profile_id",
        "profile_revision",
        "profile_digest",
        "mode_id",
        "head_id",
        "path_id",
        "model_revision",
        "native_layout_signature"
      ]
    },
    "PatchPositionCalibrationIdentity": {
      "type": "object",
      "properties": {
        "geometry_digest": {
          "type": "string"
        },
        "mode_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "profile_id",
        "mode_id",
        "geometry_digest"
      ]
    },
    "PatchProfilePolicy": {
      "type": "string",
      "enum": [
        "dmx",
        "visual_only",
        "internal"
      ]
    }
  }
}
