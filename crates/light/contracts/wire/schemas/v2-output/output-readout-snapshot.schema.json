{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutputReadoutSnapshot",
  "description": "Whole-snapshot readout of one accepted source for the requested owners, in caller order\nwith duplicates kept.",
  "type": "object",
  "properties": {
    "frame": {
      "anyOf": [
        {
          "$ref": "#/$defs/OutputFrameIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "lane": {
      "$ref": "#/$defs/VisualizationLane"
    },
    "lease": {
      "description": "Opaque, session-scoped lease of exactly this source. Absent when unavailable.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "owners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutputOwnerReadout"
      }
    },
    "revision": {
      "description": "Show revision of the source.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "scope": {
      "$ref": "#/$defs/VisualizationScope"
    },
    "unavailable": {
      "anyOf": [
        {
          "$ref": "#/$defs/OutputReadoutUnavailable"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "lane",
    "scope",
    "revision",
    "owners"
  ],
  "$defs": {
    "OutputCommonAngles": {
      "description": "Common authoring Angles, present only when every copy/emitter agrees exactly.",
      "type": "object",
      "properties": {
        "pan_degrees": {
          "type": "number",
          "format": "float"
        },
        "tilt_degrees": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "pan_degrees",
        "tilt_degrees"
      ]
    },
    "OutputFrameIdentity": {
      "description": "Identity of one evaluated output observation, independent of the show revision.",
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sampled_at": {
          "description": "Evaluation timestamp in RFC3339 format.",
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "tracking": {
          "description": "Tracking inputs captured with this output frame, when the producer supplies them.",
          "anyOf": [
            {
              "$ref": "#/$defs/OutputTrackingIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "generation",
        "sequence",
        "sampled_at"
      ]
    },
    "OutputOwnerReadout": {
      "type": "object",
      "properties": {
        "fixture_id": {
          "type": "string",
          "format": "uuid"
        },
        "position": {
          "$ref": "#/$defs/OutputPositionReadout"
        },
        "requested": {
          "description": "The typed requested Position intent of the same frame. Presentation is client-side.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProgrammingPreloadAttributeValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "fixture_id",
        "position"
      ]
    },
    "OutputPositionCommandReadout": {
      "description": "One commanded joint pair of one actual emitter of one physical copy (root or multipatch).",
      "type": "object",
      "properties": {
        "destination": {
          "type": "string",
          "format": "uuid"
        },
        "emitter_id": {
          "type": "string",
          "format": "uuid"
        },
        "pan_degrees": {
          "type": "number",
          "format": "double"
        },
        "tilt_degrees": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "destination",
        "emitter_id",
        "pan_degrees",
        "tilt_degrees"
      ]
    },
    "OutputPositionReadout": {
      "type": "object",
      "properties": {
        "available": {
          "description": "False when the owner has no complete commanded pose in this source.",
          "type": "boolean"
        },
        "commands": {
          "description": "Every copy/emitter pair, root first; divergent copies stay distinct rows.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutputPositionCommandReadout"
          }
        },
        "common": {
          "description": "`None` on divergence or unavailability. Never an average or the root's pair.",
          "anyOf": [
            {
              "$ref": "#/$defs/OutputCommonAngles"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "available",
        "commands"
      ]
    },
    "OutputReadoutUnavailable": {
      "description": "Why a readout snapshot carries no accepted source. The surface shows \"no readout\" and\nre-reads; it never substitutes another lane or a fresh evaluation.",
      "oneOf": [
        {
          "description": "No accepted Live frame has been published yet (or output is held).",
          "type": "string",
          "const": "no_accepted_frame"
        },
        {
          "description": "No accepted Pending (Preload) publication exists for this session's Programmer.",
          "type": "string",
          "const": "no_accepted_preload"
        },
        {
          "description": "The accepted source belongs to another show than the active one.",
          "type": "string",
          "const": "show_changed"
        },
        {
          "description": "The engine no longer runs the source's patch generation/layout.",
          "type": "string",
          "const": "stale_generation"
        }
      ]
    },
    "OutputTrackingIdentity": {
      "description": "Receiver and Point epochs of the tracking input held by one evaluated output frame.",
      "type": "object",
      "properties": {
        "accepted_sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "configuration_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "point_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sampled_at_millis": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "show_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "source_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "show_id",
        "configuration_generation",
        "point_generation",
        "source_generation",
        "accepted_sequence",
        "sampled_at_millis"
      ]
    },
    "ProgrammingAttributeValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "normalized"
            },
            "value": {
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "spread"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "discrete"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "color_xyz"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingColorXyz"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "color_program"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingColorProgram"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "position"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingPositionIntent"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "zoom"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingZoomIntent"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "group_family"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingGroupFamilyAssignment"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "raw_dmx"
            },
            "value": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "raw_dmx_exact"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "ProgrammingColorAllocation": {
      "type": "string",
      "enum": [
        "preserve_recipe",
        "prefer_white",
        "prefer_colored_emitters"
      ]
    },
    "ProgrammingColorComponent": {
      "type": "string",
      "enum": [
        "red",
        "green",
        "blue",
        "amber",
        "hue",
        "saturation",
        "white_blend",
        "temperature",
        "duv",
        "uv",
        "relative_output"
      ]
    },
    "ProgrammingColorComponentSpread": {
      "type": "object",
      "properties": {
        "component": {
          "$ref": "#/$defs/ProgrammingColorComponent"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "required": [
        "component",
        "points"
      ]
    },
    "ProgrammingColorIntent": {
      "type": "object",
      "properties": {
        "allocation": {
          "$ref": "#/$defs/ProgrammingColorAllocation",
          "default": "preserve_recipe"
        },
        "base_xyz": {
          "description": "Authoritative base XYZ in the pinned virtual engine. Zero is black, not D65 white.",
          "$ref": "#/$defs/ProgrammingColorXyz"
        },
        "recipe": {
          "$ref": "#/$defs/ProgrammingVirtualColorRecipe"
        },
        "relative_output": {
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "spreads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgrammingColorComponentSpread"
          }
        },
        "uv": {
          "$ref": "#/$defs/ProgrammingUvIntent",
          "default": {
            "amount": 0.0
          }
        },
        "wheel_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgrammingColorWheelConstraint"
          }
        },
        "white_blend": {
          "type": "number",
          "format": "float"
        },
        "white_target": {
          "$ref": "#/$defs/ProgrammingWhiteTarget"
        }
      },
      "required": [
        "base_xyz",
        "recipe",
        "white_blend",
        "white_target",
        "uv",
        "relative_output",
        "allocation"
      ]
    },
    "ProgrammingColorProgram": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "intent": {
              "$ref": "#/$defs/ProgrammingColorIntent"
            },
            "kind": {
              "type": "string",
              "const": "semantic"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "intent"
          ]
        },
        {
          "description": "The complete recipe and its pinned source prediction form one atomic recorded value.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "direct"
            },
            "portable": {
              "$ref": "#/$defs/ProgrammingPortableColorEstimate"
            },
            "recipe": {
              "$ref": "#/$defs/ProgrammingNativeColorRecipe"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "recipe",
            "portable"
          ]
        }
      ]
    },
    "ProgrammingColorWheelConstraint": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/ProgrammingNativeColorIdentity"
        },
        "value": {
          "$ref": "#/$defs/ProgrammingNativeColorValue"
        }
      },
      "required": [
        "source",
        "value"
      ]
    },
    "ProgrammingColorXyz": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "z": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "ProgrammingGroupFamilyAssignment": {
      "description": "Complete member exceptions remain scoped to the live Group. Nested assignments are invalid.",
      "type": "object",
      "properties": {
        "members": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ProgrammingAttributeValue"
          }
        },
        "owner": {
          "$ref": "#/$defs/ProgrammingOwner"
        },
        "template": {
          "$ref": "#/$defs/ProgrammingAttributeValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "template"
      ]
    },
    "ProgrammingNativeColorBinding": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "format": "uuid"
        },
        "function_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "channel_id",
        "function_id"
      ]
    },
    "ProgrammingNativeColorIdentity": {
      "type": "object",
      "properties": {
        "head_id": {
          "type": "string",
          "format": "uuid"
        },
        "mode_id": {
          "type": "string",
          "format": "uuid"
        },
        "model_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "native_layout_signature": {
          "type": "string"
        },
        "path_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_digest": {
          "type": "string"
        },
        "profile_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "profile_id",
        "profile_revision",
        "profile_digest",
        "mode_id",
        "head_id",
        "path_id",
        "model_revision",
        "native_layout_signature"
      ]
    },
    "ProgrammingNativeColorRecipe": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgrammingNativeColorValue"
          }
        },
        "source": {
          "$ref": "#/$defs/ProgrammingNativeColorIdentity"
        },
        "spreads": {
          "description": "Exact endpoints for profile-declared continuous native controls. Resolve before source\nprediction so each destination fits the varying recipe rather than a frozen estimate.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgrammingNativeColorSpread"
          }
        }
      },
      "required": [
        "source",
        "channels"
      ]
    },
    "ProgrammingNativeColorSpread": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/ProgrammingNativeColorBinding"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "required": [
        "binding",
        "points"
      ]
    },
    "ProgrammingNativeColorValue": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "format": "uuid"
        },
        "function_id": {
          "type": "string",
          "format": "uuid"
        },
        "raw": {
          "description": "Premaster native value. u32 preserves every supported channel width exactly.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "channel_id",
        "function_id",
        "raw"
      ]
    },
    "ProgrammingOpeningConvention": {
      "type": "string",
      "enum": [
        "beam",
        "field"
      ]
    },
    "ProgrammingOwner": {
      "type": "string",
      "enum": [
        "color",
        "position",
        "focus",
        "zoom"
      ]
    },
    "ProgrammingPhysicalDataQuality": {
      "type": "string",
      "enum": [
        "unknown",
        "estimated",
        "manufacturer",
        "measured"
      ]
    },
    "ProgrammingPortableColorEstimate": {
      "type": "object",
      "properties": {
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "quality": {
          "$ref": "#/$defs/ProgrammingPhysicalDataQuality"
        },
        "uv": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgrammingPortableUv"
            },
            {
              "type": "null"
            }
          ]
        },
        "visible": {
          "description": "None means unknown, independently of the other component. Some(zero) means known black.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProgrammingPortableVisibleColor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model_revision",
        "visible",
        "uv",
        "quality",
        "limitations"
      ]
    },
    "ProgrammingPortableUv": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "format": "float"
        },
        "quality": {
          "$ref": "#/$defs/ProgrammingPhysicalDataQuality"
        }
      },
      "required": [
        "amount",
        "quality"
      ]
    },
    "ProgrammingPortableVisibleColor": {
      "type": "object",
      "properties": {
        "relative_output": {
          "type": "number",
          "format": "float"
        },
        "xyz": {
          "$ref": "#/$defs/ProgrammingColorXyz"
        }
      },
      "required": [
        "xyz",
        "relative_output"
      ]
    },
    "ProgrammingPositionIntent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "angles"
            },
            "pan_degrees": {
              "$ref": "#/$defs/ProgrammingScalarIntent"
            },
            "tilt_degrees": {
              "$ref": "#/$defs/ProgrammingScalarIntent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "pan_degrees",
            "tilt_degrees"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "target"
            },
            "offset_metres": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProgrammingScalarIntent"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "reference": {
              "$ref": "#/$defs/ProgrammingTargetReference"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "reference",
            "offset_metres"
          ]
        }
      ]
    },
    "ProgrammingPreloadAttributeValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "normalized"
            },
            "value": {
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "spread"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "discrete"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "color_xyz"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingPreloadColorXyz"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "color_program"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingColorProgram"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "position"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingPositionIntent"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "zoom"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingZoomIntent"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "group_family"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingGroupFamilyAssignment"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "raw_dmx"
            },
            "value": {
              "type": "integer",
