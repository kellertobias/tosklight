{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgrammingInteractionSnapshot",
  "description": "Narrow repair snapshot for one desk's interaction stream.",
  "type": "object",
  "properties": {
    "cursor": {
      "$ref": "#/$defs/EventSnapshotCursor"
    },
    "projection": {
      "$ref": "#/$defs/ProgrammingInteractionProjection"
    }
  },
  "required": [
    "cursor",
    "projection"
  ],
  "$defs": {
    "CommandChoiceOption": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/CommandChoiceOptionId"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "command"
      ]
    },
    "CommandChoiceOptionId": {
      "type": "string",
      "enum": [
        "plain",
        "status"
      ]
    },
    "CommandLineResponse": {
      "description": "One authoritative command-line projection and its optimistic-concurrency revision.",
      "type": "object",
      "properties": {
        "pending_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingCommandChoice"
            },
            {
              "type": "null"
            }
          ]
        },
        "pristine": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "target": {
          "$ref": "#/$defs/CommandTarget"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "target",
        "pristine",
        "revision",
        "pending_choice"
      ]
    },
    "CommandTarget": {
      "description": "The desk-local default scope used when an operator starts a command.",
      "type": "string",
      "enum": [
        "FIXTURE",
        "GROUP"
      ]
    },
    "CueMoveCopyChoice": {
      "description": "Choice presented when Cue copy or move semantics would otherwise be ambiguous.",
      "type": "object",
      "properties": {
        "cancel_label": {
          "type": "string"
        },
        "choice_id": {
          "type": "string",
          "format": "uuid"
        },
        "command": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/CueTransferOperation"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandChoiceOption"
          }
        },
        "show_id": {
          "type": "string",
          "format": "uuid"
        },
        "show_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "$ref": "#/$defs/CueMoveCopyChoiceType"
        }
      },
      "required": [
        "type",
        "choice_id",
        "show_id",
        "show_revision",
        "operation",
        "command",
        "options",
        "cancel_label"
      ]
    },
    "CueMoveCopyChoiceType": {
      "type": "string",
      "enum": [
        "cue_move_copy"
      ]
    },
    "CueTransferOperation": {
      "type": "string",
      "enum": [
        "copy",
        "move"
      ]
    },
    "DynamicInstanceChoice": {
      "type": "object",
      "properties": {
        "cancel_label": {
          "type": "string"
        },
        "choice_id": {
          "type": "string",
          "format": "uuid"
        },
        "command": {
          "type": "string"
        },
        "dynamic_id": {
          "type": "string",
          "format": "uuid"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DynamicInstanceChoiceOption"
          }
        },
        "pool_number": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "show_id": {
          "type": "string",
          "format": "uuid"
        },
        "show_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "$ref": "#/$defs/DynamicInstanceChoiceType"
        }
      },
      "required": [
        "type",
        "choice_id",
        "show_id",
        "show_revision",
        "dynamic_id",
        "pool_number",
        "command",
        "options",
        "cancel_label"
      ]
    },
    "DynamicInstanceChoiceOption": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "controller_id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "controller_id",
        "label",
        "command"
      ]
    },
    "DynamicInstanceChoiceType": {
      "type": "string",
      "enum": [
        "dynamic_instance"
      ]
    },
    "EventSnapshotCursor": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "sequence"
      ]
    },
    "PendingCommandChoice": {
      "anyOf": [
        {
          "$ref": "#/$defs/CueMoveCopyChoice"
        },
        {
          "$ref": "#/$defs/DynamicInstanceChoice"
        }
      ]
    },
    "ProgrammerColumnsFirstTraversal": {
      "type": "string",
      "enum": [
        "top_left",
        "bottom_left",
        "top_right",
        "bottom_right"
      ]
    },
    "ProgrammerRowsFirstTraversal": {
      "type": "string",
      "enum": [
        "top_left",
        "top_right",
        "bottom_left",
        "bottom_right"
      ]
    },
    "ProgrammerSelectionExpression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "static"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "rule": {
              "$ref": "#/$defs/ProgrammerSelectionRule"
            },
            "type": {
              "type": "string",
              "const": "live_group"
            }
          },
          "required": [
            "type",
            "group_id",
            "rule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProgrammerSelectionReference"
              }
            },
            "type": {
              "type": "string",
              "const": "playback_contents"
            }
          },
          "required": [
            "type",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProgrammerSelectionReference"
              }
            },
            "type": {
              "type": "string",
              "const": "sources"
            }
          },
          "required": [
            "type",
            "items"
          ]
        }
      ]
    },
    "ProgrammerSelectionGrid": {
      "type": "object",
      "properties": {
        "columns_first": {
          "$ref": "#/$defs/ProgrammerColumnsFirstTraversal"
        },
        "configuration": {
          "$ref": "#/$defs/ProgrammerSelectionGridConfiguration"
        },
        "rows_first": {
          "$ref": "#/$defs/ProgrammerRowsFirstTraversal"
        }
      },
      "required": [
        "configuration",
        "rows_first",
        "columns_first"
      ]
    },
    "ProgrammerSelectionGridAxisOrigin": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "ProgrammerSelectionGridConfiguration": {
      "type": "object",
      "properties": {
        "axis_origin": {
          "$ref": "#/$defs/ProgrammerSelectionGridAxisOrigin",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "method": {
          "$ref": "#/$defs/ProgrammerSelectionGridMethod"
        }
      },
      "required": [
        "method",
        "axis_origin"
      ]
    },
    "ProgrammerSelectionGridMethod": {
      "type": "string",
      "enum": [
        "stage2d",
        "top_to_bottom",
        "bottom_to_top",
        "front_to_back",
        "back_to_front",
        "left_to_right",
        "right_to_left",
        "horizontal_axis_x",
        "vertical_axis_z",
        "room_depth_axis_y"
      ]
    },
    "ProgrammerSelectionProjection": {
      "description": "Ordered desk-local selection and the operation revision which produced it.",
      "type": "object",
      "properties": {
        "expression": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgrammerSelectionExpression"
            },
            {
              "type": "null"
            }
          ]
        },
        "gesture_open": {
          "type": "boolean"
        },
        "grid": {
          "description": "Portable method plus independent traversal cursors. Older servers and repaired snapshots\ndefault to the documented 2D Stage grid.",
          "$ref": "#/$defs/ProgrammerSelectionGrid",
          "default": {
            "columns_first": "top_left",
            "configuration": {
              "axis_origin": {
                "x": 0.0,
                "y": 0.0,
                "z": 0.0
              },
              "method": "stage2d"
            },
            "rows_first": "top_left"
          }
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "selected",
        "expression",
        "revision",
        "gesture_open",
        "grid"
      ]
    },
    "ProgrammerSelectionReference": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "fixture_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "fixture"
            }
          },
          "required": [
            "type",
            "fixture_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "live_group"
            }
          },
          "required": [
            "type",
            "group_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fixture_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "remove_fixture"
            }
          },
          "required": [
            "type",
            "fixture_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "remove_live_group"
            }
          },
          "required": [
            "type",
            "group_id"
          ]
        }
      ]
    },
    "ProgrammerSelectionRule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "all"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "odd"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "even"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "n": {
              "type": "integer",
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "offset": {
              "type": "integer",
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "every_nth"
            }
          },
          "required": [
            "type",
            "n",
            "offset"
          ]
        }
      ]
    },
    "ProgrammingInteractionProjection": {
      "description": "Authoritative interaction context shared by every control surface attached to one desk.",
      "type": "object",
      "properties": {
        "command_line": {
          "$ref": "#/$defs/CommandLineResponse"
        },
        "desk_id": {
          "type": "string",
          "format": "uuid"
        },
        "selection": {
          "$ref": "#/$defs/ProgrammerSelectionProjection"
        }
      },
      "required": [
        "desk_id",
        "command_line",
        "selection"
      ]
    }
  }
}
