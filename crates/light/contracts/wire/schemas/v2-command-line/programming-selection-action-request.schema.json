{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgrammingSelectionActionRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "replace"
        },
        "expected_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "action",
        "fixtures",
        "expected_revision"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "gesture"
        },
        "remove": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/ProgrammingSelectionGestureSource"
        }
      },
      "required": [
        "action",
        "source",
        "remove"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "select_group"
        },
        "expected_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "frozen": {
          "type": "boolean"
        },
        "group_id": {
          "type": "string"
        },
        "rule": {
          "$ref": "#/$defs/ProgrammerSelectionRule"
        }
      },
      "required": [
        "action",
        "group_id",
        "frozen",
        "rule",
        "expected_revision"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "apply_rule"
        },
        "rule": {
          "$ref": "#/$defs/ProgrammerSelectionRule"
        }
      },
      "required": [
        "action",
        "rule"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "cycle_grid_method"
        }
      },
      "required": [
        "action"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_grid_configuration"
        },
        "configuration": {
          "$ref": "#/$defs/ProgrammerSelectionGridConfiguration"
        },
        "expected_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "action",
        "configuration",
        "expected_revision"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "reorder_from_grid"
        },
        "axis": {
          "$ref": "#/$defs/ProgrammerSelectionGridTraversalAxis"
        }
      },
      "required": [
        "action",
        "axis"
      ]
    }
  ],
  "required": [
    "request_id"
  ],
  "$defs": {
    "ProgrammerSelectionGridAxisOrigin": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "ProgrammerSelectionGridConfiguration": {
      "type": "object",
      "properties": {
        "axis_origin": {
          "$ref": "#/$defs/ProgrammerSelectionGridAxisOrigin",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "method": {
          "$ref": "#/$defs/ProgrammerSelectionGridMethod"
        }
      },
      "required": [
        "method"
      ]
    },
    "ProgrammerSelectionGridMethod": {
      "type": "string",
      "enum": [
        "stage2d",
        "top_to_bottom",
        "bottom_to_top",
        "front_to_back",
        "back_to_front",
        "left_to_right",
        "right_to_left",
        "horizontal_axis_x",
        "vertical_axis_z",
        "room_depth_axis_y"
      ]
    },
    "ProgrammerSelectionGridTraversalAxis": {
      "type": "string",
      "enum": [
        "rows",
        "columns"
      ]
    },
    "ProgrammerSelectionRule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "all"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "odd"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "even"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "n": {
              "type": "integer",
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "offset": {
              "type": "integer",
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "every_nth"
            }
          },
          "required": [
            "type",
            "n",
            "offset"
          ]
        }
      ]
    },
    "ProgrammingSelectionGestureSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "fixture_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "fixture"
            }
          },
          "required": [
            "type",
            "fixture_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "live_group"
            }
          },
          "required": [
            "type",
            "group_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "dereferenced_group"
            }
          },
          "required": [
            "type",
            "group_id"
          ]
        }
      ]
    }
  }
}
