{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgrammingSelectionActionOutcome",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/ProgrammingSelectionAcceptedAction"
    },
    "applied": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_sequence": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "replayed": {
      "type": "boolean"
    },
    "request_id": {
      "type": "string"
    },
    "selection": {
      "$ref": "#/$defs/ProgrammerSelectionProjection"
    },
    "warning": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "request_id",
    "correlation_id",
    "action",
    "applied",
    "selection",
    "event_sequence",
    "replayed"
  ],
  "$defs": {
    "ProgrammerColumnsFirstTraversal": {
      "type": "string",
      "enum": [
        "top_left",
        "bottom_left",
        "top_right",
        "bottom_right"
      ]
    },
    "ProgrammerRowsFirstTraversal": {
      "type": "string",
      "enum": [
        "top_left",
        "top_right",
        "bottom_left",
        "bottom_right"
      ]
    },
    "ProgrammerSelectionExpression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "static"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "rule": {
              "$ref": "#/$defs/ProgrammerSelectionRule"
            },
            "type": {
              "type": "string",
              "const": "live_group"
            }
          },
          "required": [
            "type",
            "group_id",
            "rule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProgrammerSelectionReference"
              }
            },
            "type": {
              "type": "string",
              "const": "playback_contents"
            }
          },
          "required": [
            "type",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProgrammerSelectionReference"
              }
            },
            "type": {
              "type": "string",
              "const": "sources"
            }
          },
          "required": [
            "type",
            "items"
          ]
        }
      ]
    },
    "ProgrammerSelectionGrid": {
      "type": "object",
      "properties": {
        "columns_first": {
          "$ref": "#/$defs/ProgrammerColumnsFirstTraversal"
        },
        "configuration": {
          "$ref": "#/$defs/ProgrammerSelectionGridConfiguration"
        },
        "rows_first": {
          "$ref": "#/$defs/ProgrammerRowsFirstTraversal"
        }
      },
      "required": [
        "configuration",
        "rows_first",
        "columns_first"
      ]
    },
    "ProgrammerSelectionGridAxisOrigin": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "ProgrammerSelectionGridConfiguration": {
      "type": "object",
      "properties": {
        "axis_origin": {
          "$ref": "#/$defs/ProgrammerSelectionGridAxisOrigin",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "method": {
          "$ref": "#/$defs/ProgrammerSelectionGridMethod"
        }
      },
      "required": [
        "method",
        "axis_origin"
      ]
    },
    "ProgrammerSelectionGridMethod": {
      "type": "string",
      "enum": [
        "stage2d",
        "top_to_bottom",
        "bottom_to_top",
        "front_to_back",
        "back_to_front",
        "left_to_right",
        "right_to_left",
        "horizontal_axis_x",
        "vertical_axis_z",
        "room_depth_axis_y"
      ]
    },
    "ProgrammerSelectionProjection": {
      "description": "Ordered desk-local selection and the operation revision which produced it.",
      "type": "object",
      "properties": {
        "expression": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgrammerSelectionExpression"
            },
            {
              "type": "null"
            }
          ]
        },
        "gesture_open": {
          "type": "boolean"
        },
        "grid": {
          "description": "Portable method plus independent traversal cursors. Older servers and repaired snapshots\ndefault to the documented 2D Stage grid.",
          "$ref": "#/$defs/ProgrammerSelectionGrid",
          "default": {
            "columns_first": "top_left",
            "configuration": {
              "axis_origin": {
                "x": 0.0,
                "y": 0.0,
                "z": 0.0
              },
              "method": "stage2d"
            },
            "rows_first": "top_left"
          }
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "selected",
        "expression",
        "revision",
        "gesture_open",
        "grid"
      ]
    },
    "ProgrammerSelectionReference": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "fixture_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "fixture"
            }
          },
          "required": [
            "type",
            "fixture_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "live_group"
            }
          },
          "required": [
            "type",
            "group_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fixture_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "remove_fixture"
            }
          },
          "required": [
            "type",
            "fixture_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "remove_live_group"
            }
          },
          "required": [
            "type",
            "group_id"
          ]
        }
      ]
    },
    "ProgrammerSelectionRule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "all"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "odd"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "even"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "n": {
              "type": "integer",
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "offset": {
              "type": "integer",
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "every_nth"
            }
          },
          "required": [
            "type",
            "n",
            "offset"
          ]
        }
      ]
    },
    "ProgrammingSelectionAcceptedAction": {
      "type": "string",
      "enum": [
        "replaced",
        "gesture_applied",
        "group_selected",
        "rule_applied",
        "grid_method_cycled",
        "grid_configuration_set",
        "grid_reordered"
      ]
    }
  }
}
