{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PresetRecallOutcome",
  "type": "object",
  "properties": {
    "active_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "applied_fixtures": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "capture_mode_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "disposition": {
      "$ref": "#/$defs/PresetRecallDisposition"
    },
    "interaction_event_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "preload_event_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "preload_projection": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProgrammingPreloadValuesProjection"
        },
        {
          "type": "null"
        }
      ]
    },
    "preload_values_revision": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "preset": {
      "$ref": "#/$defs/RecalledPresetProjection"
    },
    "programmer_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "selected_targets": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "selection_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "show_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/PresetRecallTarget"
        },
        {
          "type": "null"
        }
      ]
    },
    "warning": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "projection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgrammingValuesProjection"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "const": "changed"
        }
      },
      "required": [
        "status"
      ]
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "no_change"
        }
      },
      "required": [
        "status"
      ]
    }
  ],
  "required": [
    "correlation_id",
    "disposition",
    "show_revision",
    "programmer_revision",
    "capture_mode_revision",
    "selection_revision",
    "applied_fixtures",
    "selected_targets",
    "preset"
  ],
  "$defs": {
    "DynamicActivationBoundaryProjection": {
      "type": "string",
      "enum": [
        "beat",
        "bar"
      ]
    },
    "DynamicActivationPolicyProjection": {
      "type": "string",
      "enum": [
        "start_now",
        "join_sync_now",
        "next_boundary"
      ]
    },
    "DynamicDefinitionProjection": {
      "type": "object",
      "properties": {
        "activation_boundary": {
          "$ref": "#/$defs/DynamicActivationBoundaryProjection"
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_activation": {
          "$ref": "#/$defs/DynamicActivationPolicyProjection"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DynamicLaneProjection"
          }
        },
        "name": {
          "type": "string"
        },
        "overall_speed_multiplier": {
          "$ref": "#/$defs/DynamicRationalProjection"
        },
        "phase": {
          "$ref": "#/$defs/DynamicPhaseDistributionProjection"
        },
        "phase_mode": {
          "$ref": "#/$defs/DynamicPhaseSpreadModeProjection"
        },
        "pool_number": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "random_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DynamicRandomGroupProjection"
          }
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "run_mode": {
          "$ref": "#/$defs/DynamicRunModeProjection"
        },
        "spatial_mapping": {
          "$ref": "#/$defs/DynamicSpatialMappingOverrideProjection"
        },
        "speed": {
          "$ref": "#/$defs/DynamicSpeedProjection"
        },
        "target_binding": {
          "$ref": "#/$defs/DynamicTargetBindingProjection"
        }
      },
      "required": [
        "id",
        "pool_number",
        "revision",
        "name",
        "target_binding",
        "lanes",
        "random_groups",
        "phase_mode",
        "spatial_mapping",
        "phase",
        "speed",
        "overall_speed_multiplier",
        "run_mode",
        "default_activation",
        "activation_boundary"
      ]
    },
    "DynamicInstanceOverridesProjection": {
      "type": "object",
      "properties": {
        "phase_offset_degrees": {
          "type": "number",
          "format": "float"
        },
        "size": {
          "type": "number",
          "format": "float"
        },
        "speed_multiplier": {
          "$ref": "#/$defs/DynamicRationalProjection"
        }
      },
      "required": [
        "size",
        "speed_multiplier",
        "phase_offset_degrees"
      ]
    },
    "DynamicKeyframeConfigurationProjection": {
      "type": "object",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DynamicKeyframeProjection"
          }
        },
        "size": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "points",
        "size"
      ]
    },
    "DynamicKeyframeProjection": {
      "type": "object",
      "properties": {
        "interpolation": {
          "$ref": "#/$defs/DynamicScalarInterpolationProjection"
        },
        "position": {
          "type": "number",
          "format": "float"
        },
        "source": {
          "$ref": "#/$defs/DynamicScalarSourceProjection"
        }
      },
      "required": [
        "position",
        "source",
        "interpolation"
      ]
    },
    "DynamicLaneModeProjection": {
      "type": "string",
      "enum": [
        "keyframes",
        "max_min",
        "middle_amplitude",
        "random"
      ]
    },
    "DynamicLaneProjection": {
      "type": "object",
      "properties": {
        "attribute": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "keyframes": {
          "$ref": "#/$defs/DynamicKeyframeConfigurationProjection"
        },
        "max_min": {
          "$ref": "#/$defs/DynamicMaxMinConfigurationProjection"
        },
        "middle_amplitude": {
          "$ref": "#/$defs/DynamicMiddleAmplitudeConfigurationProjection"
        },
        "mode": {
          "$ref": "#/$defs/DynamicLaneModeProjection"
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/DynamicPhaseDistributionProjection"
            },
            {
              "type": "null"
            }
          ]
        },
        "random_group_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "speed_multiplier": {
          "$ref": "#/$defs/DynamicRationalProjection"
        },
        "width": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "id",
        "attribute",
        "mode",
        "keyframes",
        "max_min",
        "middle_amplitude",
        "speed_multiplier",
        "width"
      ]
    },
    "DynamicMaxMinConfigurationProjection": {
      "type": "object",
      "properties": {
        "function": {
          "$ref": "#/$defs/DynamicPeriodicFunctionProjection"
        },
        "maximum": {
          "$ref": "#/$defs/DynamicScalarSourceProjection"
        },
        "minimum": {
          "$ref": "#/$defs/DynamicScalarSourceProjection"
        },
        "pwm": {
          "$ref": "#/$defs/DynamicPwmShapeProjection"
        },
        "size": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "minimum",
        "maximum",
        "function",
        "size",
        "pwm"
      ]
    },
    "DynamicMiddleAmplitudeConfigurationProjection": {
      "type": "object",
      "properties": {
        "amplitude": {
          "type": "number",
          "format": "float"
        },
        "function": {
          "$ref": "#/$defs/DynamicPeriodicFunctionProjection"
        },
        "invert_waveform": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "middle": {
          "$ref": "#/$defs/DynamicScalarSourceProjection"
        },
        "pwm": {
          "$ref": "#/$defs/DynamicPwmShapeProjection"
        },
        "size": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "middle",
        "amplitude",
        "function",
        "size",
        "pwm"
      ]
    },
    "DynamicPeriodicFunctionProjection": {
      "type": "string",
      "enum": [
        "sinus",
        "cosinus",
        "linear_up",
        "linear_down",
        "pwm"
      ]
    },
    "DynamicPhaseDistributionProjection": {
      "type": "object",
      "properties": {
        "anchors_degrees": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          }
        },
        "block_size": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "offset_degrees": {
          "type": "number",
          "format": "float"
        },
        "ordering": {
          "$ref": "#/$defs/DynamicPhaseOrderingProjection"
        },
        "repeats": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "span_degrees": {
          "type": "number",
          "format": "float"
        },
        "wings": {
          "type": "boolean"
        }
      },
      "required": [
        "ordering",
        "offset_degrees",
        "span_degrees",
        "block_size",
        "repeats",
        "wings",
        "anchors_degrees"
      ]
    },
    "DynamicPhaseOrderingProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "selection"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "angle_degrees": {
              "type": "number",
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "grid_linear"
            }
          },
          "required": [
            "type",
            "angle_degrees"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_x": {
              "type": "number",
              "format": "float"
            },
            "center_z": {
              "type": "number",
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "radial_out"
            }
          },
          "required": [
            "type",
            "center_x",
            "center_z"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_x": {
              "type": "number",
              "format": "float"
            },
            "center_z": {
              "type": "number",
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "radial_in"
            }
          },
          "required": [
            "type",
            "center_x",
            "center_z"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_x": {
              "type": "number",
              "format": "float"
            },
            "center_z": {
              "type": "number",
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "axial"
            }
          },
          "required": [
            "type",
            "center_x",
            "center_z"
          ]
        },
        {
          "type": "object",
          "properties": {
            "seed": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "random_each_loop"
            }
          },
          "required": [
            "type",
            "seed"
          ]
        }
      ]
    },
    "DynamicPhaseSpreadModeProjection": {
      "type": "string",
      "enum": [
        "uniform",
        "per_lane"
      ]
    },
    "DynamicPwmShapeProjection": {
      "type": "object",
      "properties": {
        "attack": {
          "type": "number",
          "format": "float"
        },
        "attack_interpolation": {
          "$ref": "#/$defs/DynamicScalarInterpolationProjection"
        },
        "decay": {
          "type": "number",
          "format": "float"
        },
        "decay_interpolation": {
          "$ref": "#/$defs/DynamicScalarInterpolationProjection"
        },
        "off": {
          "type": "number",
          "format": "float"
        },
        "on": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "attack",
        "on",
        "decay",
        "off",
        "attack_interpolation",
        "decay_interpolation"
      ]
    },
    "DynamicRandomGroupProjection": {
      "type": "object",
      "properties": {
        "attack_ratio": {
          "type": "number",
          "format": "float"
        },
        "decay_ratio": {
          "type": "number",
          "format": "float"
        },
        "decision_interval_millis": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "duration_spread_millis": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "high": {
          "$ref": "#/$defs/DynamicScalarSourceProjection"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "low": {
          "$ref": "#/$defs/DynamicScalarSourceProjection"
        },
        "mean_duration_millis": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "seed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start_probability": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "id",
        "seed",
        "low",
        "high",
        "decision_interval_millis",
        "start_probability",
        "mean_duration_millis",
        "duration_spread_millis",
        "attack_ratio",
        "decay_ratio"
      ]
    },
    "DynamicRationalProjection": {
      "type": "object",
      "properties": {
        "denominator": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "numerator": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "DynamicReferenceProjection": {
      "type": "object",
      "properties": {
        "dynamic_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "embedded_fallback": {
          "anyOf": [
            {
              "$ref": "#/$defs/DynamicDefinitionProjection"
            },
            {
              "type": "null"
            }
          ]
        },
        "embedded_fallback_id": {
          "type": "string",
          "format": "uuid"
        },
        "embedded_fallback_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "last_known_pool_number": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "last_known_pool_number",
        "embedded_fallback_id",
        "embedded_fallback_revision"
      ]
    },
    "DynamicRunModeProjection": {
      "type": "string",
      "enum": [
        "loop",
        "one_shot"
      ]
    },
    "DynamicScalarInterpolationProjection": {
      "type": "string",
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "ease_in_out",
        "hold",
        "drop"
      ]
    },
    "DynamicScalarSourceProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "current"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "last_valid_by_target": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DynamicTargetScalarFallbackProjection"
              }
            },
            "preset_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "preset"
            }
          },
          "required": [
            "type",
            "preset_id",
            "attribute",
            "last_valid_by_target"
          ]
        }
      ]
    },
    "DynamicSelectionShapeProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "angle_degrees": {
              "type": "number",
              "format": "double"
            },
            "direction": {
              "$ref": "#/$defs/GroupMappingRankDirection"
            },
            "type": {
              "type": "string",
              "const": "grid"
            }
          },
          "required": [
            "type",
            "angle_degrees",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_u": {
              "type": "number",
              "format": "double"
            },
            "center_v": {
              "type": "number",
              "format": "double"
            },
            "direction": {
              "$ref": "#/$defs/GroupMappingRadialDirection"
            },
            "type": {
              "type": "string",
              "const": "radial"
            }
          },
          "required": [
            "type",
            "center_u",
            "center_v",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_u": {
              "type": "number",
              "format": "double"
            },
            "center_v": {
              "type": "number",
              "format": "double"
            },
            "start_angle_degrees": {
              "type": "number",
              "format": "double"
            },
            "sweep": {
              "$ref": "#/$defs/GroupMappingRadarSweep"
            },
            "type": {
              "type": "string",
              "const": "radar"
            }
          },
          "required": [
            "type",
            "center_u",
            "center_v",
            "start_angle_degrees",
            "sweep"
          ]
        },
        {
          "type": "object",
          "properties": {
            "seed": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "random"
            }
          },
          "required": [
            "type",
            "seed"
          ]
        }
      ]
    },
    "DynamicSpatialMappingOverrideProjection": {
      "type": "object",
      "properties": {
        "projection": {
          "$ref": "#/$defs/DynamicSpatialProjectionStageProjection"
        },
        "shape": {
          "$ref": "#/$defs/DynamicSpatialShapeStageProjection"
        }
      },
      "required": [
        "projection",
        "shape"
      ]
    },
    "DynamicSpatialPosition3dProjection": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "DynamicSpatialProjectionProjection": {
      "description": "One position and one direction place every projection kind.\n\n`view_direction` is the viewing direction for planar, the central axis for cylindrical, and\nthe direction to the centre of the spread for spherical. `rotation_degrees` is the roll about\nit: the turn of the viewing plane for planar and the start angle around the axis for\ncylindrical. `anchor` is the plane origin for planar and the centre point for the other two.",
      "type": "object",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/DynamicSpatialPosition3dProjection"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroupMappingProjectionKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "preset": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroupMappingProjectionPreset"
            },
            {
              "type": "null"
            }
          ]
        },
        "rotation_degrees": {
          "type": "number",
          "format": "double"
        },
        "view_direction": {
          "$ref": "#/$defs/DynamicSpatialVector3Projection"
        }
      },
      "required": [
        "anchor",
        "view_direction",
        "rotation_degrees",
        "preset"
      ]
    },
    "DynamicSpatialProjectionStageProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "inherit"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "replace"
            },
            "value": {
              "$ref": "#/$defs/DynamicSpatialProjectionProjection"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
