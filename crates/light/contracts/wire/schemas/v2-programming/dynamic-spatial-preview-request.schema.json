{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DynamicSpatialPreviewRequest",
  "type": "object",
  "properties": {
    "expected_dynamic_revision": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "expected_show_revision": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "spatial_mapping": {
      "$ref": "#/$defs/DynamicSpatialMappingOverrideProjection"
    }
  },
  "required": [
    "expected_dynamic_revision",
    "expected_show_revision",
    "spatial_mapping"
  ],
  "$defs": {
    "DynamicSelectionShapeProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "angle_degrees": {
              "type": "number",
              "format": "double"
            },
            "direction": {
              "$ref": "#/$defs/GroupMappingRankDirection"
            },
            "type": {
              "type": "string",
              "const": "grid"
            }
          },
          "required": [
            "type",
            "angle_degrees",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_u": {
              "type": "number",
              "format": "double"
            },
            "center_v": {
              "type": "number",
              "format": "double"
            },
            "direction": {
              "$ref": "#/$defs/GroupMappingRadialDirection"
            },
            "type": {
              "type": "string",
              "const": "radial"
            }
          },
          "required": [
            "type",
            "center_u",
            "center_v",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_u": {
              "type": "number",
              "format": "double"
            },
            "center_v": {
              "type": "number",
              "format": "double"
            },
            "start_angle_degrees": {
              "type": "number",
              "format": "double"
            },
            "sweep": {
              "$ref": "#/$defs/GroupMappingRadarSweep"
            },
            "type": {
              "type": "string",
              "const": "radar"
            }
          },
          "required": [
            "type",
            "center_u",
            "center_v",
            "start_angle_degrees",
            "sweep"
          ]
        },
        {
          "type": "object",
          "properties": {
            "seed": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "random"
            }
          },
          "required": [
            "type",
            "seed"
          ]
        }
      ]
    },
    "DynamicSpatialMappingOverrideProjection": {
      "type": "object",
      "properties": {
        "projection": {
          "$ref": "#/$defs/DynamicSpatialProjectionStageProjection"
        },
        "shape": {
          "$ref": "#/$defs/DynamicSpatialShapeStageProjection"
        }
      },
      "required": [
        "projection",
        "shape"
      ]
    },
    "DynamicSpatialPosition3dProjection": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "DynamicSpatialProjectionProjection": {
      "type": "object",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/DynamicSpatialPosition3dProjection"
        },
        "preset": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroupMappingProjectionPreset"
            },
            {
              "type": "null"
            }
          ]
        },
        "rotation_degrees": {
          "type": "number",
          "format": "double"
        },
        "view_direction": {
          "$ref": "#/$defs/DynamicSpatialVector3Projection"
        }
      },
      "required": [
        "anchor",
        "view_direction",
        "rotation_degrees"
      ]
    },
    "DynamicSpatialProjectionStageProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "inherit"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "replace"
            },
            "value": {
              "$ref": "#/$defs/DynamicSpatialProjectionProjection"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "DynamicSpatialShapeStageProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "inherit"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "replace"
            },
            "value": {
              "$ref": "#/$defs/DynamicSelectionShapeProjection"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "DynamicSpatialVector3Projection": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "GroupMappingProjectionPreset": {
      "type": "string",
      "enum": [
        "top",
        "front",
        "back",
        "left",
        "right"
      ]
    },
    "GroupMappingRadarSweep": {
      "type": "string",
      "enum": [
        "clockwise",
        "counter_clockwise"
      ]
    },
    "GroupMappingRadialDirection": {
      "type": "string",
      "enum": [
        "outward",
        "inward"
      ]
    },
    "GroupMappingRankDirection": {
      "type": "string",
      "enum": [
        "ascending",
        "descending"
      ]
    }
  }
}
