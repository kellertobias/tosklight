{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GroupSettingsSnapshot",
  "type": "object",
  "properties": {
    "group": {
      "$ref": "#/$defs/GroupManagementObjectProjection"
    },
    "resolved_spatial": {
      "$ref": "#/$defs/GroupResolvedSpatialProjection"
    },
    "show_id": {
      "type": "string",
      "format": "uuid"
    },
    "show_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "show_id",
    "show_revision",
    "group",
    "resolved_spatial"
  ],
  "$defs": {
    "GroupManagementObjectProjection": {
      "description": "Authoritative lossless Group projection. These operations never delete their target.",
      "type": "object",
      "properties": {
        "body": true,
        "object_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "object_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "object_id",
        "object_revision",
        "body"
      ]
    },
    "GroupMappingPosition3d": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "GroupMappingProjection": {
      "type": "object",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/GroupMappingPosition3d"
        },
        "preset": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroupMappingProjectionPreset"
            },
            {
              "type": "null"
            }
          ]
        },
        "rotation_degrees": {
          "type": "number",
          "format": "double"
        },
        "view_direction": {
          "$ref": "#/$defs/GroupMappingVector3"
        }
      },
      "required": [
        "anchor",
        "view_direction",
        "rotation_degrees",
        "preset"
      ]
    },
    "GroupMappingProjectionPreset": {
      "type": "string",
      "enum": [
        "top",
        "front",
        "back",
        "left",
        "right"
      ]
    },
    "GroupMappingProvenanceProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "local"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "group_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "source_group_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "inherited"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "source_group_ids"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "mixed_source_mappings"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "GroupMappingRadarSweep": {
      "type": "string",
      "enum": [
        "clockwise",
        "counter_clockwise"
      ]
    },
    "GroupMappingRadialDirection": {
      "type": "string",
      "enum": [
        "outward",
        "inward"
      ]
    },
    "GroupMappingRankDirection": {
      "type": "string",
      "enum": [
        "ascending",
        "descending"
      ]
    },
    "GroupMappingShape": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "angle_degrees": {
              "type": "number",
              "format": "double"
            },
            "direction": {
              "$ref": "#/$defs/GroupMappingRankDirection"
            },
            "type": {
              "type": "string",
              "const": "grid"
            }
          },
          "required": [
            "type",
            "angle_degrees",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_u": {
              "type": "number",
              "format": "double"
            },
            "center_v": {
              "type": "number",
              "format": "double"
            },
            "direction": {
              "$ref": "#/$defs/GroupMappingRadialDirection"
            },
            "type": {
              "type": "string",
              "const": "radial"
            }
          },
          "required": [
            "type",
            "center_u",
            "center_v",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_u": {
              "type": "number",
              "format": "double"
            },
            "center_v": {
              "type": "number",
              "format": "double"
            },
            "start_angle_degrees": {
              "type": "number",
              "format": "double"
            },
            "sweep": {
              "$ref": "#/$defs/GroupMappingRadarSweep"
            },
            "type": {
              "type": "string",
              "const": "radar"
            }
          },
          "required": [
            "type",
            "center_u",
            "center_v",
            "start_angle_degrees",
            "sweep"
          ]
        }
      ]
    },
    "GroupMappingVector3": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "GroupResolvedSpatialProjection": {
      "type": "object",
      "properties": {
        "effective_mapping": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroupSpatialSelectionMapping"
            },
            {
              "type": "null"
            }
          ]
        },
        "mapping_provenance": {
          "$ref": "#/$defs/GroupMappingProvenanceProjection"
        },
        "ordered_fixture_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "rank_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "ranks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupSpatialRankProjection"
          }
        },
        "source_order": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupSpatialWarningProjection"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "source_order",
        "effective_mapping",
        "mapping_provenance",
        "ordered_fixture_ids",
        "ranks",
        "rank_count",
        "warnings"
      ]
    },
    "GroupSpatialRankProjection": {
      "type": "object",
      "properties": {
        "fixture_id": {
          "type": "string",
          "format": "uuid"
        },
        "rank": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "rank"
      ]
    },
    "GroupSpatialSelectionMapping": {
      "type": "object",
      "properties": {
        "projection": {
          "$ref": "#/$defs/GroupMappingProjection"
        },
        "shape": {
          "$ref": "#/$defs/GroupMappingShape"
        }
      },
      "required": [
        "projection",
        "shape"
      ]
    },
    "GroupSpatialWarningProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "fixture_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "missing_position"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "fixture_id"
          ]
        }
      ]
    }
  }
}
