{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CueDeletionRequest",
  "type": "object",
  "properties": {
    "address": {
      "$ref": "#/$defs/CueDeletionAddress"
    },
    "authority": {
      "$ref": "#/$defs/CueDeletionAuthority"
    },
    "cue_number": {
      "type": "string"
    },
    "request_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    }
  },
  "required": [
    "request_id",
    "address",
    "cue_number",
    "authority"
  ],
  "$defs": {
    "CueDeletionAddress": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "position": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "playback"
            }
          },
          "required": [
            "type",
            "page",
            "position"
          ]
        },
        {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "cuelist_pool"
            }
          },
          "required": [
            "type",
            "number"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expected_page": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "position": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "current_page"
            }
          },
          "required": [
            "type",
            "expected_page",
            "position"
          ]
        }
      ]
    },
    "CueDeletionAuthority": {
      "type": "object",
      "properties": {
        "cue_id": {
          "type": "string",
          "format": "uuid"
        },
        "cue_list_id": {
          "type": "string",
          "format": "uuid"
        },
        "object_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "object_revision": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "playback_address": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaybackAddressValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "cue_list_id",
        "object_id",
        "object_revision",
        "cue_id"
      ]
    },
    "PlaybackAddressValue": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "format": "uint8",
          "maximum": 99,
          "minimum": 1
        },
        "position": {
          "type": "integer",
          "format": "uint16",
          "maximum": 1000,
          "minimum": 1
        }
      },
      "required": [
        "page",
        "position"
      ]
    }
  }
}
