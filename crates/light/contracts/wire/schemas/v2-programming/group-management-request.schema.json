{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GroupManagementRequest",
  "type": "object",
  "properties": {
    "expected_object_revision": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "expected_show_revision": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "group_id": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "operation": {
      "$ref": "#/$defs/GroupManagementOperation"
    },
    "request_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    }
  },
  "required": [
    "request_id",
    "group_id",
    "operation",
    "expected_object_revision",
    "expected_show_revision"
  ],
  "$defs": {
    "GroupManagementOperation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "properties": {
              "$ref": "#/$defs/GroupPropertiesUpdate"
            },
            "type": {
              "type": "string",
              "const": "update_properties"
            }
          },
          "required": [
            "type",
            "properties"
          ]
        },
        {
          "description": "Declared as an empty struct variant so `deny_unknown_fields` still applies; serde does not\nenforce it for an internally tagged unit variant.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "undo"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expected_source": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GroupSourceExpectation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "refresh_frozen"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expected_source": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GroupSourceExpectation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "detach_derived"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mapping": {
              "$ref": "#/$defs/GroupSpatialSelectionMapping"
            },
            "type": {
              "type": "string",
              "const": "set_spatial_mapping"
            }
          },
          "required": [
            "type",
            "mapping"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "remove_spatial_mapping"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "GroupMappingPosition3d": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "GroupMappingProjection": {
      "type": "object",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/GroupMappingPosition3d"
        },
        "axis_rotation": {
          "description": "Euler degrees about X, Y then Z turning world +Z into the cylinder axis. Cylindrical only.",
          "anyOf": [
            {
              "$ref": "#/$defs/GroupMappingVector3"
            },
            {
              "type": "null"
            }
          ]
        },
        "elevation_degrees": {
          "description": "Spherical only: the centre's elevation above the plane perpendicular to world +Z.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroupMappingProjectionKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "preset": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroupMappingProjectionPreset"
            },
            {
              "type": "null"
            }
          ]
        },
        "rotation_degrees": {
          "type": "number",
          "format": "double"
        },
        "start_angle_degrees": {
          "description": "Cylindrical: where the spread starts around the axis. Spherical: the centre's azimuth.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "view_direction": {
          "$ref": "#/$defs/GroupMappingVector3"
        }
      },
      "required": [
        "anchor",
        "view_direction",
        "rotation_degrees"
      ]
    },
    "GroupMappingProjectionKind": {
      "description": "How a Stage position becomes the pair the shape ranks on. Absent means `planar`, which is\nwhat every projection stored before the other two kinds existed is.",
      "type": "string",
      "enum": [
        "planar",
        "cylindrical",
        "spherical"
      ]
    },
    "GroupMappingProjectionPreset": {
      "type": "string",
      "enum": [
        "top",
        "front",
        "back",
        "left",
        "right"
      ]
    },
    "GroupMappingRadarSweep": {
      "type": "string",
      "enum": [
        "clockwise",
        "counter_clockwise"
      ]
    },
    "GroupMappingRadialDirection": {
      "type": "string",
      "enum": [
        "outward",
        "inward"
      ]
    },
    "GroupMappingRankDirection": {
      "type": "string",
      "enum": [
        "ascending",
        "descending"
      ]
    },
    "GroupMappingShape": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "angle_degrees": {
              "type": "number",
              "format": "double"
            },
            "direction": {
              "$ref": "#/$defs/GroupMappingRankDirection"
            },
            "type": {
              "type": "string",
              "const": "grid"
            }
          },
          "required": [
            "type",
            "angle_degrees",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_u": {
              "type": "number",
              "format": "double"
            },
            "center_v": {
              "type": "number",
              "format": "double"
            },
            "direction": {
              "$ref": "#/$defs/GroupMappingRadialDirection"
            },
            "type": {
              "type": "string",
              "const": "radial"
            }
          },
          "required": [
            "type",
            "center_u",
            "center_v",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_u": {
              "type": "number",
              "format": "double"
            },
            "center_v": {
              "type": "number",
              "format": "double"
            },
            "start_angle_degrees": {
              "type": "number",
              "format": "double"
            },
            "sweep": {
              "$ref": "#/$defs/GroupMappingRadarSweep"
            },
            "type": {
              "type": "string",
              "const": "radar"
            }
          },
          "required": [
            "type",
            "center_u",
            "center_v",
            "start_angle_degrees",
            "sweep"
          ]
        }
      ]
    },
    "GroupMappingVector3": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "GroupPropertiesUpdate": {
      "type": "object",
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "icon": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        }
      },
      "required": [
        "name"
      ]
    },
    "GroupSourceExpectation": {
      "description": "Exact source authority a client observed. A mismatch fails before anything mutates.",
      "type": "object",
      "properties": {
        "expected_source_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "source_group_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        }
      },
      "required": [
        "source_group_id"
      ]
    },
    "GroupSpatialSelectionMapping": {
      "type": "object",
      "properties": {
        "projection": {
          "$ref": "#/$defs/GroupMappingProjection"
        },
        "shape": {
          "$ref": "#/$defs/GroupMappingShape"
        }
      },
      "required": [
        "projection",
        "shape"
      ]
    }
  }
}
