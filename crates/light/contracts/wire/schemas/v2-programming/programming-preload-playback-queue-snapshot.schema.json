{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgrammingPreloadPlaybackQueueSnapshot",
  "type": "object",
  "properties": {
    "cursor": {
      "$ref": "#/$defs/EventSnapshotCursor"
    },
    "projection": {
      "$ref": "#/$defs/ProgrammingPreloadPlaybackQueueProjection"
    }
  },
  "required": [
    "cursor",
    "projection"
  ],
  "$defs": {
    "EventSnapshotCursor": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "sequence"
      ]
    },
    "ProgrammingPreloadPlaybackAction": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "toggle",
            "go",
            "back",
            "off",
            "on",
            "temporary_on",
            "temporary_off",
            "dynamic_pause",
            "dynamic_restart",
            "dynamic_double_speed",
            "dynamic_half_speed",
            "dynamic_learn_speed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fader": {
              "type": "object",
              "properties": {
                "value_permyriad": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0
                }
              },
              "required": [
                "value_permyriad"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "fader"
          ]
        }
      ]
    },
    "ProgrammingPreloadPlaybackQueueItem": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ProgrammingPreloadPlaybackAction"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "playback_number": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "surface": {
          "$ref": "#/$defs/ProgrammingPreloadPlaybackSurface"
        }
      },
      "required": [
        "playback_number",
        "action",
        "surface"
      ]
    },
    "ProgrammingPreloadPlaybackQueueProjection": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgrammingPreloadPlaybackQueueItem"
          }
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "revision",
        "actions"
      ]
    },
    "ProgrammingPreloadPlaybackSurface": {
      "type": "string",
      "enum": [
        "physical",
        "virtual",
        "osc",
        "matter"
      ]
    }
  }
}
