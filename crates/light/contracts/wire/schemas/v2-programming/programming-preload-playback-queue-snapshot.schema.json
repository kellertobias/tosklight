{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgrammingPreloadPlaybackQueueSnapshot",
  "type": "object",
  "properties": {
    "cursor": {
      "$ref": "#/$defs/EventSnapshotCursor"
    },
    "projection": {
      "$ref": "#/$defs/ProgrammingPreloadPlaybackQueueProjection"
    }
  },
  "required": [
    "cursor",
    "projection"
  ],
  "$defs": {
    "EventSnapshotCursor": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "sequence"
      ]
    },
    "PlaybackAddressValue": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "format": "uint8",
          "maximum": 99,
          "minimum": 1
        },
        "position": {
          "type": "integer",
          "format": "uint16",
          "maximum": 1000,
          "minimum": 1
        }
      },
      "required": [
        "page",
        "position"
      ]
    },
    "PlaybackControlSource": {
      "type": "object",
      "properties": {
        "control_id": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "surface_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        }
      },
      "required": [
        "surface_id",
        "control_id"
      ]
    },
    "ProgrammingPreloadPlaybackAction": {
      "type": "string",
      "enum": [
        "toggle",
        "go",
        "back",
        "off",
        "on",
        "temporary_on",
        "temporary_off",
        "dynamic_pause",
        "dynamic_restart",
        "dynamic_double_speed",
        "dynamic_half_speed",
        "dynamic_learn_speed"
      ]
    },
    "ProgrammingPreloadPlaybackQueueItem": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ProgrammingPreloadPlaybackAction"
        },
        "address": {
          "$ref": "#/$defs/PlaybackAddressValue"
        },
        "control_source": {
          "$ref": "#/$defs/PlaybackControlSource"
        }
      },
      "required": [
        "address",
        "action",
        "control_source"
      ]
    },
    "ProgrammingPreloadPlaybackQueueProjection": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgrammingPreloadPlaybackQueueItem"
          }
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "revision",
        "actions"
      ]
    }
  }
}
