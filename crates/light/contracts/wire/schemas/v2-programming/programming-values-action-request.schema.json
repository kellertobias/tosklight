{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgrammingValuesActionRequest",
  "description": "One authenticated, idempotent mutation of normal, recordable Programmer values.",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/ProgrammingValuesAction"
    },
    "expected_capture_mode_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "expected_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "request_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    }
  },
  "required": [
    "request_id",
    "expected_revision",
    "expected_capture_mode_revision",
    "action"
  ],
  "$defs": {
    "DisplayedSourceRef": {
      "description": "The displayed source an edit binds its first-edit adoption to. Edits that omit it (OSC,\nHTTP integrators) keep the latest-accepted adoption; edits that carry it never fall back.",
      "type": "object",
      "properties": {
        "lane": {
          "$ref": "#/$defs/VisualizationLane"
        },
        "lease": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "lane",
        "lease"
      ]
    },
    "ExplicitColorStart": {
      "description": "`ApplyIntent.explicit_color_start`: the operator's explicit starting colour for the first\nsemantic edit of a Direct value whose visible appearance is unknown. A virtual RGB recipe\n(0..1 each); `[0,0,0]` is black. The server never invents one.",
      "type": "object",
      "properties": {
        "rgb": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "required": [
        "rgb"
      ]
    },
    "NativeColorReferenceRef": {
      "description": "`ApplyIntent.native_reference`: the root head whose native controls a Direct (`native`)\nedit names. Absent, the server takes the first verified head of the ordered selection (OSC\nand HTTP integrators). The first native edit seeds that head's current premaster output.",
      "type": "object",
      "properties": {
        "fixture_id": {
          "type": "string",
          "format": "uuid"
        },
        "head_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "fixture_id",
        "head_id"
      ]
    },
    "ProgrammingAttributeValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "normalized"
            },
            "value": {
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "spread"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "discrete"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "color_xyz"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingColorXyz"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "color_program"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingColorProgram"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "position"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingPositionIntent"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "zoom"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingZoomIntent"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "group_family"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingGroupFamilyAssignment"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "raw_dmx"
            },
            "value": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "raw_dmx_exact"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "ProgrammingColorAllocation": {
      "type": "string",
      "enum": [
        "preserve_recipe",
        "prefer_white",
        "prefer_colored_emitters"
      ]
    },
    "ProgrammingColorComponent": {
      "type": "string",
      "enum": [
        "red",
        "green",
        "blue",
        "amber",
        "hue",
        "saturation",
        "white_blend",
        "temperature",
        "duv",
        "uv",
        "relative_output"
      ]
    },
    "ProgrammingColorComponentSpread": {
      "type": "object",
      "properties": {
        "component": {
          "$ref": "#/$defs/ProgrammingColorComponent"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "required": [
        "component",
        "points"
      ]
    },
    "ProgrammingColorIntent": {
      "type": "object",
      "properties": {
        "allocation": {
          "$ref": "#/$defs/ProgrammingColorAllocation",
          "default": "preserve_recipe"
        },
        "base_xyz": {
          "description": "Authoritative base XYZ in the pinned virtual engine. Zero is black, not D65 white.",
          "$ref": "#/$defs/ProgrammingColorXyz"
        },
        "recipe": {
          "$ref": "#/$defs/ProgrammingVirtualColorRecipe"
        },
        "relative_output": {
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "spreads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgrammingColorComponentSpread"
          }
        },
        "uv": {
          "$ref": "#/$defs/ProgrammingUvIntent",
          "default": {
            "amount": 0.0
          }
        },
        "wheel_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgrammingColorWheelConstraint"
          }
        },
        "white_blend": {
          "type": "number",
          "format": "float"
        },
        "white_target": {
          "$ref": "#/$defs/ProgrammingWhiteTarget"
        }
      },
      "required": [
        "base_xyz",
        "recipe",
        "white_blend",
        "white_target"
      ]
    },
    "ProgrammingColorProgram": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "intent": {
              "$ref": "#/$defs/ProgrammingColorIntent"
            },
            "kind": {
              "type": "string",
              "const": "semantic"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "intent"
          ]
        },
        {
          "description": "The complete recipe and its pinned source prediction form one atomic recorded value.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "direct"
            },
            "portable": {
              "$ref": "#/$defs/ProgrammingPortableColorEstimate"
            },
            "recipe": {
              "$ref": "#/$defs/ProgrammingNativeColorRecipe"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "recipe",
            "portable"
          ]
        }
      ]
    },
    "ProgrammingColorWheelConstraint": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/ProgrammingNativeColorIdentity"
        },
        "value": {
          "$ref": "#/$defs/ProgrammingNativeColorValue"
        }
      },
      "required": [
        "source",
        "value"
      ]
    },
    "ProgrammingColorXyz": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "z": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "ProgrammingComponent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "component": {
              "$ref": "#/$defs/ProgrammingColorComponent"
            },
            "kind": {
              "type": "string",
              "const": "color"
            }
          },
          "required": [
            "kind",
            "component"
          ]
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "color_wheel"
            }
          },
          "required": [
            "kind",
            "component"
          ]
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "$ref": "#/$defs/ProgrammingNativeColorBinding"
            },
            "kind": {
              "type": "string",
              "const": "native_color"
            }
          },
          "required": [
            "kind",
            "component"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pan"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tilt"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "target_reference"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "target_x"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "target_y"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "target_z"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "focus"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "zoom"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ProgrammingComponentEdit": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "activate_angles"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "$ref": "#/$defs/ProgrammingComponent"
            },
            "kind": {
              "type": "string",
              "const": "scalar"
            },
            "operation": {
              "$ref": "#/$defs/ProgrammingScalarEdit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "component",
            "operation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "target"
            },
            "reference": {
              "$ref": "#/$defs/ProgrammingTargetReference"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "reference"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "coordinates"
            },
            "xyz": {
              "$ref": "#/$defs/ProgrammingColorXyz"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "xyz"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding": {
              "$ref": "#/$defs/ProgrammingNativeColorBinding"
            },
            "kind": {
              "type": "string",
              "const": "native"
            },
            "operation": {
              "$ref": "#/$defs/ProgrammingNativeColorEdit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding",
            "operation"
          ]
        }
      ]
    },
    "ProgrammingGroupFamilyAssignment": {
      "description": "Complete member exceptions remain scoped to the live Group. Nested assignments are invalid.",
      "type": "object",
      "properties": {
        "members": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ProgrammingAttributeValue"
          }
        },
        "owner": {
          "$ref": "#/$defs/ProgrammingOwner"
        },
        "template": {
          "$ref": "#/$defs/ProgrammingAttributeValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "template"
      ]
    },
    "ProgrammingIndexedPresetTarget": {
      "type": "object",
      "properties": {
        "expected_profile_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fixture_id": {
          "type": "string",
          "format": "uuid"
        },
        "function_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "fixture_id",
        "function_id",
        "expected_profile_revision"
      ]
    },
    "ProgrammingNativeColorBinding": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "format": "uuid"
        },
        "function_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "channel_id",
        "function_id"
      ]
    },
    "ProgrammingNativeColorEdit": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "set"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "spread"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "relative"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "ProgrammingNativeColorIdentity": {
      "type": "object",
      "properties": {
        "head_id": {
          "type": "string",
          "format": "uuid"
        },
        "mode_id": {
          "type": "string",
          "format": "uuid"
        },
        "model_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "native_layout_signature": {
          "type": "string"
        },
        "path_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_digest": {
          "type": "string"
        },
        "profile_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "profile_id",
        "profile_revision",
        "profile_digest",
        "mode_id",
        "head_id",
        "path_id",
        "model_revision",
        "native_layout_signature"
      ]
    },
    "ProgrammingNativeColorRecipe": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgrammingNativeColorValue"
          }
        },
        "source": {
          "$ref": "#/$defs/ProgrammingNativeColorIdentity"
        },
        "spreads": {
          "description": "Exact endpoints for profile-declared continuous native controls. Resolve before source\nprediction so each destination fits the varying recipe rather than a frozen estimate.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgrammingNativeColorSpread"
          }
        }
      },
      "required": [
        "source",
        "channels"
      ]
    },
    "ProgrammingNativeColorSpread": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/ProgrammingNativeColorBinding"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "required": [
        "binding",
        "points"
      ]
    },
    "ProgrammingNativeColorValue": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string",
          "format": "uuid"
        },
        "function_id": {
          "type": "string",
          "format": "uuid"
        },
        "raw": {
          "description": "Premaster native value. u32 preserves every supported channel width exactly.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "channel_id",
        "function_id",
        "raw"
      ]
    },
    "ProgrammingOpeningConvention": {
      "type": "string",
      "enum": [
        "beam",
        "field"
      ]
    },
    "ProgrammingOwner": {
      "type": "string",
      "enum": [
        "color",
        "position",
        "focus",
        "zoom"
      ]
    },
    "ProgrammingPhysicalDataQuality": {
      "type": "string",
      "enum": [
        "unknown",
        "estimated",
        "manufacturer",
        "measured"
      ]
    },
    "ProgrammingPickerColor": {
      "description": "Hue/saturation picker coordinates (both 0..1) as captured by the operator color dialog.",
      "type": "object",
      "properties": {
        "hue": {
          "type": "number",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        },
        "saturation": {
          "type": "number",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        }
      },
      "required": [
        "hue",
        "saturation"
      ]
    },
    "ProgrammingPortableColorEstimate": {
      "type": "object",
      "properties": {
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "quality": {
          "$ref": "#/$defs/ProgrammingPhysicalDataQuality"
        },
        "uv": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgrammingPortableUv"
            },
            {
              "type": "null"
            }
          ]
        },
        "visible": {
          "description": "None means unknown, independently of the other component. Some(zero) means known black.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProgrammingPortableVisibleColor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model_revision",
        "quality",
        "limitations"
      ]
    },
    "ProgrammingPortableUv": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "format": "float"
        },
        "quality": {
          "$ref": "#/$defs/ProgrammingPhysicalDataQuality"
        }
      },
      "required": [
        "amount",
        "quality"
      ]
    },
    "ProgrammingPortableVisibleColor": {
      "type": "object",
      "properties": {
        "relative_output": {
          "type": "number",
          "format": "float"
        },
        "xyz": {
          "$ref": "#/$defs/ProgrammingColorXyz"
        }
      },
      "required": [
        "xyz",
        "relative_output"
      ]
    },
    "ProgrammingPositionIntent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "angles"
            },
            "pan_degrees": {
              "$ref": "#/$defs/ProgrammingScalarIntent"
            },
            "tilt_degrees": {
              "$ref": "#/$defs/ProgrammingScalarIntent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "pan_degrees",
            "tilt_degrees"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "target"
            },
            "offset_metres": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProgrammingScalarIntent"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "reference": {
              "$ref": "#/$defs/ProgrammingTargetReference"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "reference",
            "offset_metres"
          ]
        }
      ]
    },
    "ProgrammingScalarEdit": {
      "oneOf": [
        {
          "type": "object",
