            },
            "group": {
              "$ref": "#/$defs/DynamicSpeedGroupProjection"
            },
            "type": {
              "type": "string",
              "const": "speed_group"
            }
          },
          "required": [
            "type",
            "group",
            "beats_per_cycle"
          ]
        }
      ]
    },
    "DynamicTargetBindingProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
