      "required": [
        "id",
        "seed",
        "low",
        "high",
        "decision_interval_millis",
        "start_probability",
        "mean_duration_millis",
        "duration_spread_millis",
        "attack_ratio",
        "decay_ratio"
      ]
    },
    "DynamicRationalProjection": {
      "type": "object",
      "properties": {
        "denominator": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "numerator": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "DynamicRunModeProjection": {
      "type": "string",
      "enum": [
        "loop",
        "one_shot"
      ]
    },
    "DynamicScalarInterpolationProjection": {
      "type": "string",
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "ease_in_out",
        "hold",
        "drop"
      ]
    },
    "DynamicScalarSourceProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "current"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "last_valid_by_target": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DynamicTargetScalarFallbackProjection"
              }
            },
            "preset_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "preset"
            }
          },
          "required": [
            "type",
            "preset_id",
            "attribute",
            "last_valid_by_target"
          ]
        }
      ]
    },
    "DynamicSpeedGroupProjection": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "DynamicSpeedProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "duration_millis": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
