        "decay": {
          "type": "number",
          "format": "float"
        },
        "decay_interpolation": {
          "$ref": "#/$defs/DynamicScalarInterpolationProjection"
        },
        "off": {
          "type": "number",
          "format": "float"
        },
        "on": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "attack",
        "on",
        "decay",
        "off",
        "attack_interpolation",
        "decay_interpolation"
      ]
    },
    "DynamicRandomGroupProjection": {
      "type": "object",
      "properties": {
        "attack_ratio": {
          "type": "number",
          "format": "float"
        },
        "decay_ratio": {
          "type": "number",
          "format": "float"
        },
        "decision_interval_millis": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "duration_spread_millis": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "high": {
          "$ref": "#/$defs/DynamicScalarSourceProjection"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "low": {
          "$ref": "#/$defs/DynamicScalarSourceProjection"
        },
        "mean_duration_millis": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "seed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start_probability": {
          "type": "number",
          "format": "float"
        }
