{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaybackTopologyActionRequest",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/PlaybackTopologyAction"
    },
    "request_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    }
  },
  "required": [
    "request_id",
    "action"
  ],
  "$defs": {
    "DynamicActivationBoundaryProjection": {
      "type": "string",
      "enum": [
        "beat",
        "bar"
      ]
    },
    "DynamicActivationPolicyProjection": {
      "type": "string",
      "enum": [
        "start_now",
        "join_sync_now",
        "next_boundary"
      ]
    },
    "DynamicDefinitionProjection": {
      "type": "object",
      "properties": {
        "activation_boundary": {
          "$ref": "#/$defs/DynamicActivationBoundaryProjection"
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_activation": {
          "$ref": "#/$defs/DynamicActivationPolicyProjection"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DynamicLaneProjection"
          }
        },
        "name": {
          "type": "string"
        },
        "overall_speed_multiplier": {
          "$ref": "#/$defs/DynamicRationalProjection"
        },
        "phase": {
          "$ref": "#/$defs/DynamicPhaseDistributionProjection"
        },
        "phase_mode": {
          "$ref": "#/$defs/DynamicPhaseSpreadModeProjection"
        },
        "pool_number": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "random_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DynamicRandomGroupProjection"
          }
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "run_mode": {
          "$ref": "#/$defs/DynamicRunModeProjection"
        },
        "speed": {
          "$ref": "#/$defs/DynamicSpeedProjection"
        },
        "target_binding": {
          "$ref": "#/$defs/DynamicTargetBindingProjection"
        }
      },
      "required": [
        "id",
        "pool_number",
        "revision",
        "name",
        "target_binding",
        "lanes",
        "random_groups",
        "phase_mode",
        "phase",
        "speed",
        "overall_speed_multiplier",
        "run_mode",
        "default_activation",
        "activation_boundary"
      ]
    },
    "DynamicKeyframeConfigurationProjection": {
      "type": "object",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DynamicKeyframeProjection"
          }
        },
        "size": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "points",
        "size"
      ]
    },
    "DynamicKeyframeProjection": {
      "type": "object",
      "properties": {
        "interpolation": {
          "$ref": "#/$defs/DynamicScalarInterpolationProjection"
        },
        "position": {
          "type": "number",
          "format": "float"
        },
        "source": {
          "$ref": "#/$defs/DynamicScalarSourceProjection"
        }
      },
      "required": [
        "position",
        "source",
        "interpolation"
      ]
    },
    "DynamicLaneModeProjection": {
      "type": "string",
      "enum": [
        "keyframes",
        "max_min",
        "middle_amplitude",
        "random"
      ]
    },
    "DynamicLaneProjection": {
      "type": "object",
      "properties": {
        "attribute": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "keyframes": {
          "$ref": "#/$defs/DynamicKeyframeConfigurationProjection"
        },
        "max_min": {
          "$ref": "#/$defs/DynamicMaxMinConfigurationProjection"
        },
        "middle_amplitude": {
          "$ref": "#/$defs/DynamicMiddleAmplitudeConfigurationProjection"
        },
        "mode": {
          "$ref": "#/$defs/DynamicLaneModeProjection"
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/DynamicPhaseDistributionProjection"
            },
            {
              "type": "null"
            }
          ]
        },
        "random_group_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "speed_multiplier": {
          "$ref": "#/$defs/DynamicRationalProjection"
        },
        "width": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "id",
        "attribute",
        "mode",
        "keyframes",
        "max_min",
        "middle_amplitude",
        "speed_multiplier",
        "width"
      ]
    },
    "DynamicMaxMinConfigurationProjection": {
      "type": "object",
      "properties": {
        "function": {
          "$ref": "#/$defs/DynamicPeriodicFunctionProjection"
        },
        "maximum": {
          "$ref": "#/$defs/DynamicScalarSourceProjection"
        },
        "minimum": {
          "$ref": "#/$defs/DynamicScalarSourceProjection"
        },
        "pwm": {
          "$ref": "#/$defs/DynamicPwmShapeProjection"
        },
        "size": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "minimum",
        "maximum",
        "function",
        "size",
        "pwm"
      ]
    },
    "DynamicMiddleAmplitudeConfigurationProjection": {
      "type": "object",
      "properties": {
        "amplitude": {
          "type": "number",
          "format": "float"
        },
        "function": {
          "$ref": "#/$defs/DynamicPeriodicFunctionProjection"
        },
        "middle": {
          "$ref": "#/$defs/DynamicScalarSourceProjection"
        },
        "pwm": {
          "$ref": "#/$defs/DynamicPwmShapeProjection"
        },
        "size": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "middle",
        "amplitude",
        "function",
        "size",
        "pwm"
      ]
    },
    "DynamicPeriodicFunctionProjection": {
      "type": "string",
      "enum": [
        "sinus",
        "cosinus",
        "linear_up",
        "linear_down",
        "pwm"
      ]
    },
    "DynamicPhaseDistributionProjection": {
      "type": "object",
      "properties": {
        "anchors_degrees": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          }
        },
        "block_size": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "offset_degrees": {
          "type": "number",
          "format": "float"
        },
        "ordering": {
          "$ref": "#/$defs/DynamicPhaseOrderingProjection"
        },
        "repeats": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "span_degrees": {
          "type": "number",
          "format": "float"
        },
        "wings": {
          "type": "boolean"
        }
      },
      "required": [
        "ordering",
        "offset_degrees",
        "span_degrees",
        "block_size",
        "repeats",
        "wings",
        "anchors_degrees"
      ]
    },
    "DynamicPhaseOrderingProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "selection"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "angle_degrees": {
              "type": "number",
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "grid_linear"
            }
          },
          "required": [
            "type",
            "angle_degrees"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_x": {
              "type": "number",
              "format": "float"
            },
            "center_z": {
              "type": "number",
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "radial_out"
            }
          },
          "required": [
            "type",
            "center_x",
            "center_z"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_x": {
              "type": "number",
              "format": "float"
            },
            "center_z": {
              "type": "number",
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "radial_in"
            }
          },
          "required": [
            "type",
            "center_x",
            "center_z"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center_x": {
              "type": "number",
              "format": "float"
            },
            "center_z": {
              "type": "number",
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "axial"
            }
          },
          "required": [
            "type",
            "center_x",
            "center_z"
          ]
        },
        {
          "type": "object",
          "properties": {
            "seed": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "random_each_loop"
            }
          },
          "required": [
            "type",
            "seed"
          ]
        }
      ]
    },
    "DynamicPhaseSpreadModeProjection": {
      "type": "string",
      "enum": [
        "uniform",
        "per_lane"
      ]
    },
    "DynamicPwmShapeProjection": {
      "type": "object",
      "properties": {
        "attack": {
          "type": "number",
          "format": "float"
