{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaybackActionRequest",
  "description": "One live control action. Repeated actions execute independently and are never replayed.",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/PlaybackAction"
    },
    "address": {
      "$ref": "#/$defs/PlaybackAddress"
    },
    "control_source": {
      "$ref": "#/$defs/PlaybackControlSource"
    }
  },
  "required": [
    "address",
    "action",
    "control_source"
  ],
  "$defs": {
    "PlaybackAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "go"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "back"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "pause"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "release"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "controller_id": {
              "type": "string",
              "format": "uuid"
            },
            "dynamic_id": {
              "type": "string",
              "format": "uuid"
            },
            "instance_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "runtime_stop_dynamic"
            }
          },
          "required": [
            "type",
            "dynamic_id",
            "instance_id",
            "controller_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "on"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "off"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "toggle"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "fast_forward"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "fast_rewind"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "flash"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "temp"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "swap"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "select"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "select_contents"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "select_dereferenced"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "learn"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "double"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "half"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "blackout"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "pause_dynamics"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "dynamic_restart"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "dynamic_double_speed"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "dynamic_half_speed"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "dynamic_learn_speed"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "master"
            },
            "value": {
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cue_number": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "go_to"
            }
          },
          "required": [
            "type",
            "cue_number"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cue_number": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "load"
            }
          },
          "required": [
            "type",
            "cue_number"
          ]
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "crossfade"
            }
          },
          "required": [
            "type",
            "enabled"
          ]
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "temporary"
            }
          },
          "required": [
            "type",
            "enabled",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "pressed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "configured_button"
            }
          },
          "required": [
            "type",
            "number",
            "pressed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "level": {
              "type": "number",
              "format": "float"
            },
            "number": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "configured_fader"
            }
          },
          "required": [
            "type",
            "number",
            "level"
          ]
        }
      ]
    },
    "PlaybackAddress": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "cue_list_id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "cue_list"
            }
          },
          "required": [
            "kind",
            "cue_list_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "const": "group"
            }
          },
          "required": [
            "kind",
            "group_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "playback"
            },
            "page": {
              "type": "integer",
              "format": "uint8",
              "maximum": 99,
              "minimum": 1
            },
            "position": {
              "type": "integer",
              "format": "uint16",
              "maximum": 1000,
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "page",
            "position"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "current_page"
            },
            "position": {
              "type": "integer",
              "format": "uint16",
              "maximum": 1000,
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "position"
          ]
        }
      ]
    },
    "PlaybackControlSource": {
      "type": "object",
      "properties": {
        "control_id": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "surface_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        }
      },
      "required": [
        "surface_id",
        "control_id"
      ]
    }
  }
}
