{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageLayoutActionRequest",
  "description": "Body of the idempotent stage-layout action POST operation.",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/StageLayoutAction"
    },
    "request_id": {
      "description": "Client-generated idempotency identity, scoped to the authenticated desk session.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    }
  },
  "required": [
    "request_id",
    "action"
  ],
  "$defs": {
    "StageLayoutAction": {
      "description": "One stage-layout intent, using the shared fan-out vocabulary: an explicitly ordered\nselection plus a typed operation payload (see `ProgrammingValueMutation::SetSelection`).",
      "oneOf": [
        {
          "description": "Applies one uniform axis delta to every selected fixture. The server resolves each base\nposition exactly like the stage views: the stored 3D entry, else the migrated legacy 2D\nentry, else the patch-order default grid slot; selected ids outside the patch are skipped.",
          "type": "object",
          "properties": {
            "axis": {
              "$ref": "#/$defs/StagePositionAxis"
            },
            "delta": {
              "description": "Meters for translation axes, degrees for rotation axes. Must be finite.",
              "type": "number",
              "format": "double"
            },
            "fixture_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 10000,
              "minItems": 1
            },
            "type": {
              "type": "string",
              "const": "move_selection"
            }
          },
          "required": [
            "type",
            "fixture_ids",
            "axis",
            "delta"
          ]
        },
        {
          "description": "Writes one operator-authored 2D position and switches the layout to manual provenance.",
          "type": "object",
          "properties": {
            "fixture_id": {
              "type": "string",
              "format": "uuid"
            },
            "position": {
              "$ref": "#/$defs/StagePosition2d"
            },
            "type": {
              "type": "string",
              "const": "set_position_2d"
            }
          },
          "required": [
            "type",
            "fixture_id",
            "position"
          ]
        },
        {
          "description": "Stores the independent width and depth of one Crowd Area without changing its height.",
          "type": "object",
          "properties": {
            "depth_metres": {
              "type": "number",
              "format": "double"
            },
            "fixture_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "set_crowd_footprint"
            },
            "width_metres": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "type",
            "fixture_id",
            "width_metres",
            "depth_metres"
          ]
        },
        {
          "description": "Intentionally replaces the complete 2D map from the stored 3D positions.",
          "type": "object",
          "properties": {
            "projection": {
              "$ref": "#/$defs/StageProjection2d"
            },
            "type": {
              "type": "string",
              "const": "regenerate_2d"
            }
          },
          "required": [
            "type",
            "projection"
          ]
        }
      ]
    },
    "StagePosition2d": {
      "type": "object",
      "properties": {
        "rotation": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "rotation"
      ]
    },
    "StagePositionAxis": {
      "description": "One editable component of a fixture's 3D stage position.",
      "type": "string",
      "enum": [
        "x",
        "y",
        "z",
        "rotation_x",
        "rotation_y",
        "rotation_z"
      ]
    },
    "StageProjection2d": {
      "type": "string",
      "enum": [
        "top_to_bottom",
        "bottom_to_top",
        "front_to_back",
        "back_to_front",
        "left_to_right",
        "right_to_left"
      ]
    }
  }
}
