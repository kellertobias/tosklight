{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelectiveImportCatalog",
  "type": "object",
  "properties": {
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SelectiveImportCatalogObject"
      }
    },
    "source_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "source_show_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_show_name": {
      "type": "string"
    }
  },
  "required": [
    "source_show_id",
    "source_show_name",
    "source_revision",
    "objects"
  ],
  "$defs": {
    "SelectiveImportCatalogObject": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/SelectiveImportObjectKey"
        },
        "object_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "patch_layer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "$ref": "#/$defs/SelectiveImportCatalogSection"
        }
      },
      "required": [
        "key",
        "object_revision",
        "display_name",
        "section",
        "patch_layer_id"
      ]
    },
    "SelectiveImportCatalogSection": {
      "type": "string",
      "enum": [
        "fixture_patch",
        "groups",
        "presets_mixed",
        "presets_intensity",
        "presets_color",
        "presets_position",
        "presets_beam",
        "dynamics",
        "cuelists",
        "playbacks",
        "schedules",
        "stage",
        "macros",
        "other"
      ]
    },
    "SelectiveImportObjectKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ]
    }
  }
}
