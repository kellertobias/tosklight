{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgrammingValuesActionRequest",
  "description": "One authenticated, idempotent mutation of normal, recordable Programmer values.",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/ProgrammingValuesAction"
    },
    "expected_capture_mode_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "expected_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "request_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    }
  },
  "required": [
    "request_id",
    "expected_revision",
    "expected_capture_mode_revision",
    "action"
  ],
  "$defs": {
    "ProgrammingAttributeValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "normalized"
            },
            "value": {
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "spread"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "discrete"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "color_xyz"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingColorXyz"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "raw_dmx"
            },
            "value": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "raw_dmx_exact"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "ProgrammingColorXyz": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "z": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "ProgrammingPickerColor": {
      "description": "Hue/saturation picker coordinates (both 0..1) as captured by the operator color dialog.",
      "type": "object",
      "properties": {
        "hue": {
          "type": "number",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        },
        "saturation": {
          "type": "number",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        }
      },
      "required": [
        "hue",
        "saturation"
      ]
    },
    "ProgrammingValueMutation": {
      "oneOf": [
        {
          "description": "Server-side fan-out over an explicitly ordered selection: `Spread` control points\ninterpolate across the given fixture order; any other value applies uniformly. This is the\nshared fan-out vocabulary (ordered selection + typed operation payload) also used by the\ncolor and position fan-out families.",
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "fixture_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 10000
            },
            "timing": {
              "$ref": "#/$defs/ProgrammingValueTiming",
              "default": {
                "fade": false
              }
            },
            "type": {
              "type": "string",
              "const": "set_selection"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingAttributeValue"
            }
          },
          "required": [
            "type",
            "fixture_ids",
            "attribute",
            "value"
          ]
        },
        {
          "description": "Server-side color-range fan-out over an explicitly ordered selection: the picker\nendpoints interpolate hue-aware across the fixture order — `hue_travel` carries the\ngesture's total signed hue distance in revolutions (1.0 = once around the wheel), so\nlong-way-around and multi-revolution ranges are expressible — and every fixture stores\nonly the color channels its heads support.",
          "type": "object",
          "properties": {
            "brightness": {
              "type": "number",
              "format": "float",
              "maximum": 1.0,
              "minimum": 0.0
            },
            "end": {
              "$ref": "#/$defs/ProgrammingPickerColor"
            },
            "fixture_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 10000
            },
            "hue_travel": {
              "type": "number",
              "format": "float"
            },
            "start": {
              "$ref": "#/$defs/ProgrammingPickerColor"
            },
            "timing": {
              "$ref": "#/$defs/ProgrammingValueTiming",
              "default": {
                "fade": false
              }
            },
            "type": {
              "type": "string",
              "const": "set_selection_color_range"
            }
          },
          "required": [
            "type",
            "fixture_ids",
            "start",
            "end",
            "hue_travel",
            "brightness"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "fixture_id": {
              "type": "string",
              "format": "uuid"
            },
            "timing": {
              "$ref": "#/$defs/ProgrammingValueTiming",
              "default": {
                "fade": false
              }
            },
            "type": {
              "type": "string",
              "const": "set_fixture"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingAttributeValue"
            }
          },
          "required": [
            "type",
            "fixture_id",
            "attribute",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "fixture_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "release_fixture"
            }
          },
          "required": [
            "type",
            "fixture_id",
            "attribute"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "group_id": {
              "type": "string"
            },
            "timing": {
              "$ref": "#/$defs/ProgrammingValueTiming",
              "default": {
                "fade": false
              }
            },
            "type": {
              "type": "string",
              "const": "set_group"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingAttributeValue"
            }
          },
          "required": [
            "type",
            "group_id",
            "attribute",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "group_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "release_group"
            }
          },
          "required": [
            "type",
            "group_id",
            "attribute"
          ]
        }
      ]
    },
    "ProgrammingValueOperation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "absolute_set"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingAttributeValue"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "delta": {
              "type": "number",
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "relative_step"
            }
          },
          "required": [
            "type",
            "delta"
          ]
        }
      ]
    },
    "ProgrammingValueTiming": {
      "type": "object",
      "properties": {
        "delay_millis": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "fade": {
          "type": "boolean",
          "default": false
        },
        "fade_millis": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "ProgrammingValuesAction": {
      "oneOf": [
        {
          "description": "One application-owned fixture/head value intent. The server resolves ordered spreads,\nrelative steps, and any configured linked-attribute captures atomically.",
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "fixture_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 10000
            },
            "operation": {
              "$ref": "#/$defs/ProgrammingValueOperation"
            },
            "timing": {
              "$ref": "#/$defs/ProgrammingValueTiming",
              "default": {
                "fade": false
              }
            },
            "type": {
              "type": "string",
              "const": "apply_intent"
            }
          },
          "required": [
            "type",
            "fixture_ids",
            "attribute",
            "operation"
          ]
        },
        {
          "description": "Server-side fan-out over an explicitly ordered selection (see\n`ProgrammingValueMutation::SetSelection`).",
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "fixture_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 10000
            },
            "timing": {
              "$ref": "#/$defs/ProgrammingValueTiming",
              "default": {
                "fade": false
              }
            },
            "type": {
              "type": "string",
              "const": "set_selection"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingAttributeValue"
            }
          },
          "required": [
            "type",
            "fixture_ids",
            "attribute",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "fixture_id": {
              "type": "string",
              "format": "uuid"
            },
            "timing": {
              "$ref": "#/$defs/ProgrammingValueTiming",
              "default": {
                "fade": false
              }
            },
            "type": {
              "type": "string",
              "const": "set_fixture"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingAttributeValue"
            }
          },
          "required": [
            "type",
            "fixture_id",
            "attribute",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "fixture_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "release_fixture"
            }
          },
          "required": [
            "type",
            "fixture_id",
            "attribute"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "group_id": {
              "type": "string"
            },
            "timing": {
              "$ref": "#/$defs/ProgrammingValueTiming",
              "default": {
                "fade": false
              }
            },
            "type": {
              "type": "string",
              "const": "set_group"
            },
            "value": {
              "$ref": "#/$defs/ProgrammingAttributeValue"
            }
          },
          "required": [
            "type",
            "group_id",
            "attribute",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "group_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "release_group"
            }
          },
          "required": [
            "type",
            "group_id",
            "attribute"
          ]
        },
        {
          "description": "Server-side color-range fan-out over an explicitly ordered selection: the picker\nendpoints interpolate hue-aware across the fixture order — `hue_travel` carries the\ngesture's total signed hue distance in revolutions (1.0 = once around the wheel), so\nlong-way-around and multi-revolution ranges are expressible — and every fixture stores\nonly the color channels its heads support.",
          "type": "object",
          "properties": {
            "brightness": {
              "type": "number",
              "format": "float",
              "maximum": 1.0,
              "minimum": 0.0
            },
            "end": {
              "$ref": "#/$defs/ProgrammingPickerColor"
            },
            "fixture_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 10000
            },
            "hue_travel": {
              "type": "number",
              "format": "float"
            },
            "start": {
              "$ref": "#/$defs/ProgrammingPickerColor"
            },
            "timing": {
              "$ref": "#/$defs/ProgrammingValueTiming",
              "default": {
                "fade": false
              }
            },
            "type": {
              "type": "string",
              "const": "set_selection_color_range"
            }
          },
          "required": [
            "type",
            "fixture_ids",
            "start",
            "end",
            "hue_travel",
            "brightness"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mutations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProgrammingValueMutation"
              },
              "maxItems": 10000
            },
            "type": {
              "type": "string",
              "const": "batch"
            }
          },
          "required": [
            "type",
            "mutations"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "clear"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    }
  }
}
