{
	"name": "tosklight",
	"version": "0.0.0",
	"private": true,
	"description": "ToskLight show-lighting control desk, engine, and control server.",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "https://github.com/kellertobias/tosklight.git"
	},
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"apps/light-desktop",
		"apps/light-hardware-controls",
		"apps/media",
		"apps/patch-library",
		"apps/patch-mcp",
		"apps/ui-library",
		"apps/viz-editor"
	],
	"scripts": {
		"dev": "bash tools/dev.sh both",
		"dev:ui": "bash tools/dev.sh ui",
		"dev:headless": "bash tools/dev.sh headless",
		"dev:app": "bash tools/dev.sh app",
		"codesafari": "bash tools/build.sh codesafari",
		"open": "bash tools/build.sh open",
		"build:open": "bash tools/build.sh build-open",
		"open:hardware-controls": "bash tools/build.sh open-hardware-controls",
		"build:hardware-controls:open": "bash tools/build.sh build-hardware-controls-open",
		"open:media": "bash tools/build.sh open-media",
		"build:media:open": "bash tools/build.sh build-media-open",
		"build:media": "bash tools/build.sh build-media",
		"convert:media": "bash tools/convert-media.sh",
		"open:viz": "bash tools/build.sh open-viz",
		"build:viz:open": "bash tools/build.sh build-viz-open",
		"build:viz": "bash tools/build.sh build-viz",
		"open:viz-editor": "bash tools/build.sh open-viz-editor",
		"build:viz-editor:open": "bash tools/build.sh build-viz-editor-open",
		"build:viz-editor": "bash tools/build.sh build-viz-editor",
		"demo-show": "bash tools/build.sh demo-show",
		"demo-capture": "bash tools/build.sh demo-capture",
		"bundle": "bash tools/build.sh archive",
		"bundle:install": "bash tools/build.sh archive install",
		"manual": "bash tools/build.sh manual",
		"icons:contact-sheets": "bash tools/build.sh icon-contact-sheets",
		"gobos": "python3 tools/gobo-artwork.py && python3 tools/gobo-package.py",
		"gobos:verify": "python3 tools/gobo-artwork.py --check && python3 tools/gobo-package.py --check",
		"models": "bash tools/build.sh models",
		"models:verify": "bash tools/build.sh models verify",
		"models:render": "bash tools/build.sh models render",
		"models:open": "bash tools/build.sh models open",
		"pages:generate": "bash tools/build.sh pages",
		"pages:serve": "bash tools/build.sh pages-serve",
		"clean": "npm run clean:artifacts",
		"clean:root": "bash tools/build.sh clean-root",
		"clean:artifacts": "bash tools/build.sh clean-artifacts",
		"clean:cargo-incremental": "bash tools/build.sh clean-cargo-incremental",
		"migrate-artifacts": "bash tools/build.sh migrate-artifacts",
		"artifact-path": "bash tools/build.sh path",
		"test": "bash tools/test.sh unit",
		"test:unit": "bash tools/test.sh unit",
		"test:typescript-unit": "bash tools/test.sh typescript-unit",
		"test:verify": "bash tools/test.sh verify",
		"test:architecture": "bash tools/test.sh architecture",
		"lint:control-labels": "node tools/check-control-state-labels.mjs",
		"test:semantic-test-docs": "node --test tools/semantic-test-docs/*.test.mjs",
		"test:bench-unit": "vitest run tests/bench",
		"docs:semantic-tests:write": "node tools/semantic-test-docs/cli.mjs --write",
		"docs:semantic-tests:check": "node tools/semantic-test-docs/cli.mjs --check",
		"test:bench-types": "node_modules/.bin/tsc --noEmit --pretty false --strict --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,DOM --skipLibCheck tests/bench/window-system/paneTypes.typecheck.ts",
		"test:e2e": "bash tools/test.sh e2e",
		"test:e2e-api": "bash tools/test.sh e2e-api",
		"test:e2e-ui": "bash tools/test.sh e2e-ui",
		"test:e2e-performance": "bash tools/test.sh e2e-performance",
		"test:app-icons": "bash tools/test.sh app-icons",
		"test:artifact-paths": "bash tools/test.sh artifact-paths",
		"test:ui-package": "npm run typecheck --workspace @tosklight/ui && npm run test --workspace @tosklight/ui",
		"test:patch-package": "npm run typecheck --workspace @tosklight/patch && npm run test --workspace @tosklight/patch",
		"test:patch-mcp": "npm run typecheck --workspace @tosklight/patch-mcp && npm run test --workspace @tosklight/patch-mcp",
		"test:viz-editor": "npm run typecheck --workspace @tosklight/viz-editor && npm run test --workspace @tosklight/viz-editor",
		"test:media-app": "npm run typecheck --workspace @tosklight/media && npm run test --workspace @tosklight/media",
		"storybook": "npm run storybook --workspace @tosklight/ui",
		"storybook:build": "npm run storybook:build --workspace @tosklight/ui",
		"screenshots:marketing": "bash tools/test.sh marketing-screenshots",
		"screenshots:help": "bash tools/test.sh help-screenshots && bash tools/test.sh help-screenshots-live",
		"test:storybook": "npm run test:storybook --workspace @tosklight/ui",
		"test:marketing-screenshots": "bash tools/test.sh marketing-screenshots",
		"test:help-screenshots": "bash tools/test.sh help-screenshots",
		"test:help-screenshots-live": "bash tools/test.sh help-screenshots-live",
		"benchmark:sustained-output": "node tools/run-sustained-output-benchmark.mjs",
		"benchmark:headless-stress": "node tools/run-headless-stress-benchmark.mjs",
		"benchmark:packaged-stage": "node tools/run-packaged-stage-benchmark.mjs",
		"benchmark:supported-scale": "node tools/run-packaged-stage-benchmark.mjs 30 supported-scale",
		"test:record": "bash tools/test.sh record",
		"test:demo-show": "bash tools/test.sh demo-show",
		"test:demo": "bash tools/test.sh demo",
		"test:all": "bash tools/test.sh all",
		"release": "node tools/run-semantic-release.mjs",
		"release:dry-run": "node tools/run-semantic-release.mjs --dry-run"
	},
	"devDependencies": {
		"@babel/parser": "^7.29.7",
		"@playwright/test": "^1.61.1",
		"@semantic-release/commit-analyzer": "^13.0.0",
		"@semantic-release/github": "^11.0.0",
		"@semantic-release/release-notes-generator": "^14.0.3",
		"conventional-changelog-conventionalcommits": "^9.1.0",
		"semantic-release": "^24.2.3",
		"typescript": "latest",
		"vitest": "^4.1.10"
	}
}
